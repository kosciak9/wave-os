{
  "title": "Hosty T3",
  "rows": [
    {
      "title": "jayce",
      "panels": [
        {
          "title": "CPU",
          "unit": "%",
          "width": 6,
          "expr": [
            "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"jayce\",mode=\"idle\"}[5m])))",
            "100 * avg by (mode) (rate(node_cpu_seconds_total{host=\"jayce\",mode=~\"user|system|iowait\"}[5m]))"
          ],
          "alias": [
            "razem",
            "{{mode}}"
          ]
        },
        {
          "title": "Pamięć",
          "description": "MemTotal − MemAvailable.",
          "unit": "GiB",
          "width": 6,
          "expr": [
            "(node_memory_MemTotal_bytes{host=\"jayce\"} - node_memory_MemAvailable_bytes{host=\"jayce\"}) / 2^30",
            "node_memory_MemTotal_bytes{host=\"jayce\"} / 2^30"
          ],
          "alias": [
            "zajęta",
            "całość"
          ]
        },
        {
          "title": "Procesy: CPU",
          "description": "100% = jeden rdzeń. Dziesięć nazw o najwyższej średniej w wybranym zakresie.",
          "unit": "%",
          "width": 6,
          "expr": [
            "topk_avg(10, 100 * sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{host=\"jayce\"}[5m])))"
          ],
          "alias": [
            "{{groupname}}"
          ]
        },
        {
          "title": "Procesy: pamięć (RSS)",
          "description": "Suma RSS procesów o tej nazwie; pamięć współdzielona liczy się wielokrotnie. Dziesięć nazw o najwyższej średniej w wybranym zakresie.",
          "unit": "GiB",
          "width": 6,
          "expr": [
            "topk_avg(10, namedprocess_namegroup_memory_bytes{host=\"jayce\",memtype=\"resident\"} / 2^30)"
          ],
          "alias": [
            "{{groupname}}"
          ]
        }
      ]
    },
    {
      "title": "renekton",
      "panels": [
        {
          "title": "CPU",
          "unit": "%",
          "width": 6,
          "expr": [
            "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"renekton\",mode=\"idle\"}[5m])))",
            "100 * avg by (mode) (rate(node_cpu_seconds_total{host=\"renekton\",mode=~\"user|system|iowait\"}[5m]))"
          ],
          "alias": [
            "razem",
            "{{mode}}"
          ]
        },
        {
          "title": "Pamięć",
          "description": "Pamięć bez free i inactive.",
          "unit": "GiB",
          "width": 6,
          "expr": [
            "(node_memory_total_bytes{host=\"renekton\"} - node_memory_free_bytes{host=\"renekton\"} - node_memory_inactive_bytes{host=\"renekton\"}) / 2^30",
            "node_memory_total_bytes{host=\"renekton\"} / 2^30"
          ],
          "alias": [
            "zajęta",
            "całość"
          ]
        },
        {
          "title": "Procesy: CPU",
          "description": "Średnie %CPU z ps (100% = jeden rdzeń). Dziesięć nazw o najwyższej średniej w wybranym zakresie.",
          "unit": "%",
          "width": 6,
          "expr": [
            "topk_avg(10, darwin_process_cpu_percent{host=\"renekton\"})"
          ],
          "alias": [
            "{{groupname}}"
          ]
        },
        {
          "title": "Procesy: pamięć (RSS)",
          "description": "Suma RSS procesów o tej nazwie; pamięć współdzielona liczy się wielokrotnie. Dziesięć nazw o najwyższej średniej w wybranym zakresie.",
          "unit": "GiB",
          "width": 6,
          "expr": [
            "topk_avg(10, darwin_process_resident_bytes{host=\"renekton\"} / 2^30)"
          ],
          "alias": [
            "{{groupname}}"
          ]
        }
      ]
    },
