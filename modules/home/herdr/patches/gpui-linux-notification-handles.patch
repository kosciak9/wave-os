 type ResponseCallback = Rc<RefCell<Option<Box<dyn FnMut(SystemNotificationResponse)>>>>;
 
+#[derive(Default)]
+struct Delivery {
+    handle: Option<Arc<notify_rust::NotificationHandle>>,
+    dismissed: bool,
+}
+
+fn dismiss_delivery(delivery: &Mutex<Delivery>) {
+    let handle = {
+        let mut delivery = delivery.lock().unwrap();
+        delivery.dismissed = true;
+        delivery.handle.take()
+    };
+    if let Some(handle) = handle {
+        std::thread::spawn(move || smol::block_on(handle.close_async()));
+    }
+}
