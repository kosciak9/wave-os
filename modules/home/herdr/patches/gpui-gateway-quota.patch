+fn fetch_snapshot(
+    config: &settings::GatewayConfig,
+    base: &url::Url,
+) -> Result<Snapshot, &'static str> {
+    let key = read_file(&config.key_file, 16 * 1024)?;
+    let key = key.trim();
+    if key.is_empty() || !key.bytes().all(|byte| byte.is_ascii_graphic()) {
+        return Err("Gateway key invalid");
+    }
+    let authorization = Zeroizing::new(format!("Bearer {key}"));
+    let mut header =
+        ureq::http::HeaderValue::from_str(&authorization).map_err(|_| "Gateway key invalid")?;
+    header.set_sensitive(true);
+    let agent: ureq::Agent = ureq::Agent::config_builder()
+        .timeout_global(Some(Duration::from_secs(15)))
+        .proxy(None)
+        .https_only(base.scheme() == "https")
+        .max_redirects(0)
+        .http_status_as_error(false)
+        .build()
+        .into();
+    let endpoint = base.join("v1/quota").map_err(|_| "Gateway URL invalid")?;
+    let mut response = agent
+        .get(endpoint.as_str())
+        .header("Authorization", header)
+        .call()
+        .map_err(|_| "Gateway unreachable")?;
+    if response.status().as_u16() != 200 {
+        return Err("Gateway request failed");
+    }
+    let mut body = Zeroizing::new(Vec::new());
+    response
+        .body_mut()
+        .as_reader()
+        .take(RESPONSE_LIMIT + 1)
+        .read_to_end(&mut body)
+        .map_err(|_| "Gateway response unavailable")?;
+    if body.len() as u64 > RESPONSE_LIMIT {
+        return Err("Gateway response too large");
+    }
+    let snapshot: Snapshot =
+        serde_json::from_slice(&body).map_err(|_| "Gateway response invalid")?;
+    validate(&snapshot)?;
+    Ok(snapshot)
