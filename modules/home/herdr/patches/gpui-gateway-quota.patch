+fn remaining(limit: &Limit) -> String {
+    let mut parts = Vec::new();
+    if let Some(percent) = limit.remaining_percent {
+        parts.push(format!("{percent:.0}% left"));
+    }
+    if let Some(value) = limit.remaining {
+        let unit = limit.unit.as_deref().unwrap_or("");
+        parts.push(match limit.total {
+            Some(total) => format!("{}/{} {unit}", amount(value), amount(total)),
+            None => format!("{} {unit} left", amount(value)),
+        });
+    }
+    if parts.is_empty() {
+        "Unavailable".into()
+    } else {
+        parts.join(" · ")
+    }
+}
+
+fn amount(value: f64) -> String {
+    if value.fract() == 0.0 {
+        format!("{value:.0}")
+    } else if value < 0.01 {
+        format!("{value:.2e}")
+    } else {
+        format!("{value:.2}")
+            .trim_end_matches('0')
+            .trim_end_matches('.')
+            .to_owned()
+    }
+}
+
+fn reset(at: Option<u64>, now: u64) -> String {
+    match at {
+        None => "reset —".into(),
+        Some(at) if at <= now => "reset due".into(),
+        Some(at) => format!("in {}", duration(at - now)),
+    }
+}
+
+fn age(at: u64, now: u64) -> String {
+    if at == 0 {
+        "—".into()
+    } else {
+        format!("{} ago", duration(now.saturating_sub(at)))
+    }
+}
+
+fn duration(seconds: u64) -> String {
+    match seconds {
+        0..60 => "<1m".into(),
+        60..3600 => format!("{}m", seconds / 60),
+        3600..86400 => format!("{}h {}m", seconds / 3600, seconds % 3600 / 60),
+        _ => format!("{}d {}h", seconds / 86400, seconds % 86400 / 3600),
+    }
+}
