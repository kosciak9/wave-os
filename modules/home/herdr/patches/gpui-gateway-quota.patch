+fn validate(snapshot: &Snapshot) -> Result<(), &'static str> {
+    let text_ok = |text: &str| text.len() <= 256 && !text.chars().any(char::is_control);
+    let mut ids = std::collections::HashSet::new();
+    if snapshot.accounts.len() > 256
+        || snapshot.accounts.iter().any(|account| {
+            account.id.is_empty()
+                || !text_ok(&account.id)
+                || !ids.insert(&account.id)
+                || !text_ok(&account.provider)
+                || !text_ok(&account.label)
+                || account.limits.len() > 32
+                || account.limits.iter().any(|limit| {
+                    !text_ok(&limit.label)
+                        || limit.unit.as_ref().is_some_and(|unit| !text_ok(unit))
+                        || limit
+                            .remaining_percent
+                            .is_some_and(|n| !n.is_finite() || !(0.0..=100.0).contains(&n))
+                        || [limit.remaining, limit.total]
+                            .into_iter()
+                            .flatten()
+                            .any(|n| !n.is_finite() || n < 0.0)
+                })
+        })
+    {
+        return Err("Gateway response invalid");
     }
