+    pub(super) fn remember_worktree_preparation(&mut self, workspace: &str) {
+        let Some(target) = self.menu.target.as_ref() else {
+            return;
+        };
+        let note = self.menu.worktree.as_mut().and_then(|source| {
+            let origin = source.lookup.origin.clone()?;
+            match source.pending.take()? {
+                Pending::Item(item) => Some((item, origin)),
+                _ => None,
+            }
+        });
+        self.worktree_preparations.push(Preparation {
+            endpoint_id: self.endpoints[self.selected_endpoint].id.clone(),
+            boot: target.boot_id.clone(),
+            workspace: workspace.to_owned(),
+            repo: target
+                .worktree
+                .as_ref()
+                .map_or_else(|| target.label.clone(), |tree| tree.label.clone()),
+            repo_key: target
+                .worktree
+                .as_ref()
+                .map(|tree| tree.key.clone())
+                .unwrap_or_default(),
+            note,
+            observed: false,
+        });
+    }
+
+    pub(crate) fn poll_worktree_preparations(&mut self, cx: &mut Context<Self>) {
+        let preparations = std::mem::take(&mut self.worktree_preparations);
+        for mut preparation in preparations {
+            let Some(index) = self
+                .endpoints
+                .iter()
+                .position(|endpoint| endpoint.id == preparation.endpoint_id)
+            else {
+                continue;
+            };
+            let endpoint = &self.endpoints[index];
+            let live = if index == self.selected_endpoint {
+                &self.live
+            } else {
+                &endpoint.live
+            };
+            let Some(snapshot) = &live.snapshot else {
+                self.worktree_preparations.push(preparation);
+                continue;
+            };
+            if snapshot.boot_id != preparation.boot {
+                continue;
+            }
+            let Some(workspace) = snapshot
+                .workspaces
+                .iter()
+                .find(|workspace| workspace.workspace_id == preparation.workspace)
+            else {
+                if !preparation.observed {
+                    self.worktree_preparations.push(preparation);
+                }
+                continue;
+            };
+            preparation.observed = true;
+            let checkout = workspace
+                .worktree
+                .as_ref()
+                .filter(|tree| tree.is_linked_worktree)
+                .and_then(|tree| tree.checkout_path.as_deref())
+                .filter(|path| std::path::Path::new(path).is_absolute())
+                .map(str::to_owned);
+            let Some(path) = checkout else {
+                self.worktree_preparations.push(preparation);
+                continue;
+            };
+            if preparation.repo_key.is_empty()
+                && let Some(tree) = &workspace.worktree
+            {
+                preparation.repo_key = tree.key.clone();
+            }
+            // Deferred setup never selects an endpoint or workspace the user left.
+            let ready = index == self.selected_endpoint
+                && live.status.is_connected()
+                && snapshot.focused_workspace_id.as_deref() == Some(preparation.workspace.as_str())
+                && self.worktree_script.is_none();
+            if let Some((item, origin)) = preparation.note.take() {
+                self.write_checkout_note(path.clone().into(), item, origin, cx);
+            }
+            if !ready {
+                self.worktree_preparations.push(preparation);
+                continue;
+            }
+            let launch = crate::worktree_scripts::Launch {
+                kind: crate::worktree_scripts::ScriptKind::Setup,
+                endpoint: (self.selection_epoch, self.endpoints[index].generation),
+                endpoint_id: preparation.endpoint_id,
+                boot: preparation.boot,
+                workspace: preparation.workspace,
+                repo: preparation.repo,
+                repo_key: preparation.repo_key,
+                checkout: None,
+                force: false,
+                requested: false,
+            };
+            if let Err(error) = self.start_worktree_script(launch, cx) {
+                self.local_error = Some(format!("The setup script did not start: {error}"));
+                cx.notify();
+            } else if let Some(job) = &mut self.worktree_script {
+                job.preserve_focus = true;
+            }
+        }
     }
