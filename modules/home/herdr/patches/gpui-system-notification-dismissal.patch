 impl HerdrWindow {
+    pub(crate) fn dismiss_viewed_system_notifications(&mut self, cx: &mut Context<Self>) {
+        // A background window or an unfinished navigation has not shown the agent yet.
+        if !self.active || self.menu.page.is_some() || !self.input_ready() {
+            return;
+        }
+        // Hidden browser tabs and parked editor groups do not acknowledge a notice.
+        if self.primary_group().is_some_and(|group| {
+            Some(group) != self.active_group()
+                || self.group_shown(group, cx) != crate::browser::Shown::Terminal
+        }) {
+            return;
+        }
+
+        let Some(snapshot) = self.live.snapshot.as_deref() else {
+            return;
+        };
+        let Some(pane) = snapshot.focused_pane_id.as_deref() else {
+            return;
+        };
+        let endpoint = &mut self.endpoints[self.selected_endpoint];
+        let tag = format!("herdr:{}:{}:{pane}", endpoint.id, snapshot.boot_id);
+        let Some(registry) = cx.try_global::<Registry>() else {
+            return;
+        };
+        if registry.find(&tag).is_none() {
+            return;
+        }
+        // Tags include host and boot; viewing one agent must not clear another's notice.
+        cx.global_mut::<Registry>()
+            .posted
+            .retain(|posted| posted.tag.as_ref() != tag.as_str());
+        cx.dismiss_system_notification(&tag);
+        endpoint.toasts.entries.retain(|(_, notice)| {
+            !notice.posted || notice.target(snapshot) != Some(crate::NavigationTarget::Pane(pane))
+        });
+    }
+
