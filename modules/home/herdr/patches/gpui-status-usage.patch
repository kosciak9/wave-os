diff --git a/crates/herdr-gpui/src/usage/headlines.rs b/crates/herdr-gpui/src/usage/headlines.rs
new file mode 100644
index 0000000..2a3f372
--- /dev/null
+++ b/crates/herdr-gpui/src/usage/headlines.rs
@@ -0,0 +1,119 @@
+//! Persistent providers for the two status-bar positions, shared by all windows.
+
+use super::{Entry, HEADLINE, Provider, has_numbers, registry};
+use crate::state_file;
+use gpui::{App, Global};
+use serde::{Deserialize, Serialize};
+
+#[derive(Default, Serialize, Deserialize)]
+struct Saved {
+    providers: [Option<String>; HEADLINE],
+}
+
+#[derive(Default)]
+pub(crate) struct Headlines {
+    providers: [Option<Provider>; HEADLINE],
+    writer: Option<state_file::Writer<Saved>>,
+}
+
+impl Global for Headlines {}
+
+impl Headlines {
+    pub(crate) fn load() -> Self {
+        let path = crate::preferences::state_dir().map(|dir| dir.join("usage-headlines.json"));
+        let saved = path
+            .as_deref()
+            .map(|path| {
+                state_file::read(path, 16 * 1024).and_then(|bytes| {
+                    bytes.map_or(Ok(Saved::default()), |bytes| {
+                        Ok(serde_json::from_slice::<Saved>(&bytes)?)
+                    })
+                })
+            })
+            .transpose()
+            .unwrap_or_else(|error| {
+                tracing::warn!(%error, "Cannot restore usage selections");
+                None
+            })
+            .unwrap_or_default();
+        let mut providers = saved
+            .providers
+            .map(|id| id.and_then(|id| registry::find(&id)));
+        if providers[0].is_some() && providers[0] == providers[1] {
+            providers[1] = None;
+        }
+        let writer = path.and_then(|path| {
+            state_file::Writer::start("usage-headlines", path)
+                .map_err(|error| tracing::warn!(%error, "Cannot start usage selection writer"))
+                .ok()
+        });
+        Self { providers, writer }
+    }
+
+    pub(crate) fn install(self, cx: &mut App) {
+        cx.set_global(self);
+        cx.on_app_quit(|cx| {
+            let writer = cx.global_mut::<Self>().writer.take();
+            cx.background_executor().spawn(async move {
+                if let Some(writer) = writer {
+                    writer.finish();
+                }
+            })
+        })
+        .detach();
+    }
+
+    pub(crate) fn providers(cx: &App) -> [Option<Provider>; HEADLINE] {
+        cx.try_global::<Self>()
+            .map_or([None; HEADLINE], |headlines| headlines.providers)
+    }
+
+    /// Fill only unassigned positions, after a complete read, in registry order.
+    /// Missing providers keep their position instead of promoting another account.
+    pub(crate) fn fill(entry: &Entry, cx: &mut App) {
+        let mut providers = Self::providers(cx);
+        for reading in &entry.readings {
+            if !(has_numbers(reading) || reading.access.is_some())
+                || providers.contains(&Some(reading.provider))
+            {
+                continue;
+            }
+            let Some(slot) = providers.iter_mut().find(|provider| provider.is_none()) else {
+                break;
+            };
+            *slot = Some(reading.provider);
+        }
+        Self::save(providers, cx);
+    }
+
+    pub(crate) fn choose(slot: usize, provider: Provider, cx: &mut App) {
+        let mut providers = Self::providers(cx);
+        if let Some(other) = providers
+            .iter()
+            .position(|chosen| *chosen == Some(provider))
+        {
+            // Selecting the other position's provider swaps, rather than duplicating it.
+            providers.swap(slot, other);
+        } else {
+            providers[slot] = Some(provider);
+        }
+        Self::save(providers, cx);
+    }
+
+    fn save(providers: [Option<Provider>; HEADLINE], cx: &mut App) {
+        if providers == Self::providers(cx) {
+            return;
+        }
+        if !cx.has_global::<Self>() {
+            cx.set_global(Self::default());
+        }
+        let headlines = cx.global_mut::<Self>();
+        headlines.providers = providers;
+        if let Some(writer) = &headlines.writer {
+            writer.save(Saved {
+                providers: providers
+                    .map(|provider| provider.map(|provider| provider.id().to_owned())),
+            });
+        }
+    }
+}
