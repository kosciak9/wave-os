+
+fn reset_credits(value: serde_json::Value) -> Option<Section> {
+    let credits: ResetCredits = serde_json::from_value(value).ok()?;
+    if !credits.eligible {
+        return None;
+    }
+    let now = SystemTime::now();
+    let available = credits
+        .grants
+        .into_iter()
+        .filter_map(|value| {
+            let grant: ResetGrant = serde_json::from_value(value).ok()?;
+            if grant.paused
+                || grant
+                    .resets_total
+                    .is_some_and(|total| total < grant.resets_left)
+            {
+                return None;
+            }
+            if let Some(start) = grant.starts_at {
+                if start.time()? > now {
+                    return None;
+                }
+            }
+            if let Some(end) = grant.ends_at {
+                if end.time()? <= now {
+                    return None;
+                }
+            }
+            Some(grant.resets_left)
+        })
+        .try_fold(0_u32, u32::checked_add)?;
+    Some(Section::Facts {
+        title: "Limit reset credits".into(),
+        facts: vec![("Available".into(), available.to_string())],
+    })
+}
+
+#[derive(Deserialize)]
+struct ResetCredits {
+    eligible: bool,
+    grants: Vec<serde_json::Value>,
+}
+
+#[derive(Deserialize)]
+struct ResetGrant {
+    resets_left: u32,
+    resets_total: Option<u32>,
+    starts_at: Option<Timestamp>,
+    ends_at: Option<Timestamp>,
+    paused: bool,
 }
 
 #[derive(Deserialize)]
