 impl SidebarLook {
+    pub(super) fn with_font(
+        mut self,
+        font: &crate::config::FontConfig,
+        window: &gpui::Window,
+    ) -> Self {
+        let text = window.text_system();
+        let id = text.resolve_font(&font.font());
+        let size = px(font.size);
+        // Center the visible capitals, not the font's unequal ascent/descent box.
+        self.text_offset = f32::from(
+            (text.cap_height(id, size) - text.ascent(id, size) + text.descent(id, size)) / 2.,
+        )
+        .clamp(-self.row_padding(), self.row_padding());
+        self
+    }
+
     pub(super) fn inset(&self) -> f32 {
         self.density.inset
     }
