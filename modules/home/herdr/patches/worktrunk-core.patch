+// Worktrunk runs Git itself, so a request-scoped `safe.directory` reaches it
+// through Git's command-scope configuration environment instead of `-c`.
+fn worktrunk_command(
+    repo_root: &Path,
+    trust_repository: bool,
+    args: impl IntoIterator<Item = String>,
+) -> WorktreeCommand {
+    let env = if trust_repository {
+        vec![
+            ("GIT_CONFIG_COUNT".to_string(), "1".to_string()),
+            ("GIT_CONFIG_KEY_0".to_string(), "safe.directory".to_string()),
+            ("GIT_CONFIG_VALUE_0".to_string(), repo_root.display().to_string()),
+        ]
+    } else {
+        Vec::new()
+    };
+    WorktreeCommand {
+        program: "wt".to_string(),
+        args: ["-C".to_string(), repo_root.display().to_string()]
+            .into_iter()
+            .chain(args)
+            .collect(),
+        env,
+    }
+}
+
 pub(crate) fn default_checkout_path(root: &Path, repo_name: &str, branch: &str) -> PathBuf {
     root.join(repo_name).join(branch_to_path_slug(branch))
