diff --git a/src/app/api/worktrees/terminal.rs b/src/app/api/worktrees/terminal.rs
new file mode 100644
--- /dev/null
+++ b/src/app/api/worktrees/terminal.rs
@@ -0,0 +1,79 @@
+use crate::app::App;
+
+use super::super::responses::{encode_error, encode_success};
+use super::WorktreeSource;
+
+impl App {
+    pub(super) fn start_worktree_terminal(
+        &mut self,
+        id: String,
+        mut source: WorktreeSource,
+        branch: String,
+        base: String,
+        label: Option<String>,
+        focus: bool,
+        trust_repository: bool,
+    ) -> String {
+        let Some(program) = std::env::var_os("HERDR_WORKTREE_TERMINAL") else {
+            return encode_error(
+                id,
+                "worktree_create_failed",
+                "worktree preparation terminal is not configured",
+            );
+        };
+        if let Err(err) = self.ensure_source_parent_membership(&mut source, true) {
+            return encode_error(id, err.code, err.message);
+        }
+        let shell = crate::pane::resolved_pane_shell(crate::pane::PaneShellConfig::new(
+            &self.state.default_shell,
+            self.state.shell_mode,
+        ));
+        let login = matches!(self.state.shell_mode, crate::config::ShellModeConfig::Login)
+            || (matches!(self.state.shell_mode, crate::config::ShellModeConfig::Auto)
+                && cfg!(target_os = "macos"));
+        let argv = vec![
+            program.to_string_lossy().into_owned(),
+            source.source_checkout_path.display().to_string(),
+            branch.clone(),
+            base,
+            shell,
+            if login { "login" } else { "non-login" }.into(),
+            self.public_workspace_id(source.workspace_idx.expect("source workspace exists")),
+        ];
+        let mut env = crate::worktree::build_worktrunk_switch_command(
+            &source.source_checkout_path,
+            &branch,
+            None,
+            trust_repository,
+        )
+        .env;
+        if trust_repository {
+            env.push(("HERDR_WORKTREE_TRUST".into(), "1".into()));
+        }
+        let ws_idx = match self.create_workspace_with_command(
+            source.source_checkout_path,
+            focus,
+            env,
+            Some(&argv),
+        ) {
+            Ok(ws_idx) => ws_idx,
+            Err(err) => return encode_error(id, "worktree_create_failed", err.to_string()),
+        };
+        // Preparation is one-shot; restoring this terminal must only open a shell.
+        let workspace = &self.state.workspaces[ws_idx];
+        let terminal_id = workspace
+            .terminal_id(workspace.tabs[0].root_pane)
+            .expect("preparation terminal exists");
+        if let Some(terminal) = self.state.terminals.get_mut(terminal_id) {
+            terminal.launch_argv = None;
+            terminal.respawn_shell_on_exit = false;
+        }
+        self.state.workspaces[ws_idx].set_custom_name(label.unwrap_or(branch));
+        self.emit_workspace_open_events(ws_idx);
+        encode_success(
+            id,
+            self.workspace_created_result(ws_idx)
+                .expect("preparation workspace has a terminal"),
+        )
+    }
+}
