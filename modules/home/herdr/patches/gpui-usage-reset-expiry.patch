+        );
+        for section in &mut report.sections {
+            if let Section::Facts { title, facts } = section
+                && title == "Limit reset credits"
+            {
+                *title = "Available resets".into();
+                facts.push(("Expiry dates".into(), "Unavailable".into()));
+            }
+        }
+        ui.standard(&report)
+    }
+}
+
+fn reset_inventory(body: &str) -> Result<Section> {
+    let inventory: ResetInventory = json(body)?;
+    let now = SystemTime::now();
+    let mut expiries: Vec<_> = inventory
+        .credits
+        .into_iter()
+        .filter(|credit| credit.status == "available")
+        .map(|credit| credit.expires_at.as_ref().and_then(Timestamp::time))
+        .filter(|expiry| expiry.is_none_or(|expiry| expiry > now))
+        .collect();
+    expiries.sort_unstable_by_key(|expiry| (expiry.is_none(), *expiry));
+    let facts = if expiries.is_empty() {
+        vec![("Available".into(), "None".into())]
+    } else {
+        expiries
+            .into_iter()
+            .enumerate()
+            .map(|(index, expiry)| {
+                let expiry = expiry.map_or_else(
+                    || "Expiry not provided".into(),
+                    |expiry| {
+                        let local = chrono::DateTime::<chrono::Local>::from(expiry);
+                        format!("Expires {}", local.format("%d %b %Y, %H:%M %:z"))
+                    },
+                );
+                (format!("Reset {}", index + 1), expiry)
+            })
+            .collect()
+    };
+    Ok(Section::Facts {
+        title: "Available resets".into(),
+        facts,
+    })
+}
+
+#[derive(Deserialize)]
+struct ResetInventory {
+    credits: Vec<ResetCredit>,
+}
+
+#[derive(Deserialize)]
+struct ResetCredit {
+    status: String,
+    expires_at: Option<Timestamp>,
 }
 
