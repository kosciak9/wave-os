{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "ଚ",
  "plugin": [
    // [
    //   "@plannotator/opencode@0.27.25",
    //   {
    //     "workflow": "plan-agent",
    //     "planningAgents": ["brainstorm-planner"],
    //     "runtime": "cli",
    //   },
    // ],
    "opencode-websearch@0.6.0",
    "@slkiser/opencode-quota@4.9.0",
    "cc-safety-net@2.4.1",
  ],
  "tools": {
    "quota_status": false,
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "if CONTEXT7_API_KEY=$(pass show context7.com/api-key 2>/dev/null); then export CONTEXT7_API_KEY; else unset CONTEXT7_API_KEY; fi; exec npx -y @upstash/context7-mcp@4.1.1",
      ],
      "enabled": true,
    },
  },
  "permission": {
    "external_directory": {
      "~/Developer/personal/wave-os/**": "allow",
      "~/Developer/personal/wave-os.*/**": "allow",
      "~/.local/state/wave/**": "allow",
      "/nix/store/**": "allow",
      "/nix/var/log/nix/**": "allow",
    },
    "bash": {
      "*": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git grep *": "allow",

      "gh search *": "allow",
      "gh repo view *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",

      "npm view *": "allow",
      "npm info *": "allow",
      "npm search *": "allow",
    },
    "edit": "deny",
  },
  "agent": {
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "options": {
        "reasoningEffort": "low",
      },
    },
    "summary": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
    },
    "ଚ": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "fast",
      "permission": {
        "edit": "allow",
        "question": "allow",
      },
    },
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "task": "allow",
      },
    },
    "explore": {
      "description": "Codebase and documentation researcher with file reading/search, Bash, web search/fetch, and Context7. No edit or skill tools; include task-specific instructions and relevant context when delegating.",
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "permission": {
        "edit": "deny",
        "context7_*": "allow",
        "skill": "deny",
      },
    },
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "options": {
            "websearch": "always",
            "serviceTier": "default",
          },
        },
        "gpt-6.1-sol": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
            },
          },
          "options": {
            "serviceTier": "default",
            "reasoningEffort": "medium",
          },
        },
        "gpt-6-astra": {
          "options": {
            "serviceTier": "default",
          },
        },
      },
    },
  },
}
