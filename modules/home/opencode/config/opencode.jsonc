{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "ଚ",
  // Nix owns the binary. Do not let the CLI replace it.
  "update": "disable",
  "plugins": ["cc-safety-net@2.6.0"],
  // Use the anonymous Parallel MCP instead of a separate search provider.
  "websearch": false,
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "if CONTEXT7_API_KEY=$(pass show context7.com/api-key 2>/dev/null); then export CONTEXT7_API_KEY; else unset CONTEXT7_API_KEY; fi; exec npx -y @upstash/context7-mcp@4.1.1",
        ],
        "codemode": false,
      },
      // Anonymous free tier. OAuth is on by default for remote servers and this
      // endpoint does not use it.
      "parallel-search": {
        "type": "remote",
        "url": "https://search.parallel.ai/mcp",
        "oauth": false,
        "codemode": false,
      },
    },
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna#low",
    },
    "summary": {
      "model": "openai/gpt-6.1-sol#medium",
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol#medium",
    },
    "ଚ": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol#medium",
    },
    "build": {
      "disabled": true,
    },
    "plan": {
      "disabled": true,
    },
    "general": {
      "model": "openai/gpt-6.1-sol#medium",
      // The built-in general agent denies launching subagents.
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "allow" }],
    },
    "explore": {
      "description": "Codebase and documentation researcher with file reading/search, Bash, web search/fetch, and Context7. No edit or skill tools; include task-specific instructions and relevant context when delegating.",
      "model": "openai/gpt-6-luna#low",
      // The built-in explore agent denies everything except reads and web tools.
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "parallel-search_*", "resource": "*", "effect": "allow" },
      ],
    },
  },
}
