{
  "$schema": "https://vicinae.com/schemas/extension.json",
  "name": "himalaya",
  "title": "Himalaya",
  "description": "Read, archive and trash mail from a unified inbox",
  "icon": "icon.svg",
  "author": "wave-os",
  "license": "MIT",
  "version": "1.0.0",
  "commands": [
    {
      "name": "inbox",
      "title": "Inbox",
      "subtitle": "Himalaya",
      "description": "Search, read, archive and trash mail across all accounts",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@vicinae/api": "0.29.1",
    "react": "19.3.0",
    "sanitize-html": "2.18.1",
    "turndown": "7.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "vici build",
    "typecheck": "tsc --noEmit"
  }
}
