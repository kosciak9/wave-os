diff --git a/src/storage/frecency.ts b/src/storage/frecency.ts
new file mode 100644
index 0000000..2128624
--- /dev/null
+++ b/src/storage/frecency.ts
@@ -0,0 +1,154 @@
+import { createHash } from "crypto";
+import { LocalStorage } from "@vicinae/api";
+import { LastUsedRecord, PasswordOptionType } from "@/types";
+
+const HALF_LIFE_MS = 10 * 24 * 60 * 60 * 1000;
+const CONTINUATION_MS = 120 * 1000;
+const MAX_ENTRIES = 512;
+const MAX_SCORE = 1_000_000;
+
+type UsageRecord = { entry: string; score: number; timestamp: number };
+export type UsageState = {
+  entries: UsageRecord[];
+  lastUsed: LastUsedRecord | null;
+};
+
+const emptyUsage = (): UsageState => ({ entries: [], lastUsed: null });
+const storageKey = (store: string) =>
+  `pass-usage-v1:${createHash("sha256").update(store).digest("hex")}`;
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isTimestamp(value: unknown, now: number): value is number {
+  return (
+    typeof value === "number" &&
+    Number.isSafeInteger(value) &&
+    value > 0 &&
+    value <= now
+  );
+}
+
+function isUsageRecord(value: unknown, now: number): value is UsageRecord {
+  return (
+    isObject(value) &&
+    typeof value.entry === "string" &&
+    value.entry.length > 0 &&
+    value.entry.length <= 4096 &&
+    typeof value.score === "number" &&
+    Number.isFinite(value.score) &&
+    value.score > 0 &&
+    value.score <= MAX_SCORE &&
+    isTimestamp(value.timestamp, now)
+  );
+}
+
+function isLastUsed(value: unknown, now: number): value is LastUsedRecord {
+  return (
+    isObject(value) &&
+    typeof value.password === "string" &&
+    value.password.length > 0 &&
+    value.password.length <= 4096 &&
+    typeof value.option === "string" &&
+    ["Password", "OTP", "Other"].includes(value.option) &&
+    isTimestamp(value.timestamp, now)
+  );
+}
+
+export function usageScore(
+  record: UsageRecord | undefined,
+  now: number,
+): number {
+  return record
+    ? record.score * 2 ** (-Math.max(0, now - record.timestamp) / HALF_LIFE_MS)
+    : 0;
+}
+
+async function readUsage(store: string, now: number): Promise<UsageState> {
+  const stored: unknown = await LocalStorage.getItem(storageKey(store));
+  if (typeof stored !== "string") return emptyUsage();
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(stored);
+  } catch {
+    return emptyUsage();
+  }
+  if (
+    !isObject(parsed) ||
+    parsed.version !== 1 ||
+    !Array.isArray(parsed.entries) ||
+    parsed.entries.length > MAX_ENTRIES
+  )
+    return emptyUsage();
+  return {
+    entries: parsed.entries
+      .filter((value): value is UsageRecord => isUsageRecord(value, now))
+      .map(({ entry, score, timestamp }) => ({ entry, score, timestamp })),
+    lastUsed: isLastUsed(parsed.lastUsed, now)
+      ? {
+          password: parsed.lastUsed.password,
+          option: parsed.lastUsed.option,
+          timestamp: parsed.lastUsed.timestamp,
+        }
+      : null,
+  };
+}
+
+async function writeUsage(store: string, usage: UsageState): Promise<void> {
+  await LocalStorage.setItem(
+    storageKey(store),
+    JSON.stringify({ version: 1, ...usage }),
+  );
+}
+
+export async function loadUsage(
+  store: string,
+  available: string[],
+): Promise<UsageState> {
+  const usage = await readUsage(store, Date.now());
+  const entries = new Set(available);
+  const pruned: UsageState = {
+    entries: usage.entries.filter((record) => entries.has(record.entry)),
+    lastUsed:
+      usage.lastUsed && entries.has(usage.lastUsed.password)
+        ? usage.lastUsed
+        : null,
+  };
+  if (JSON.stringify(pruned) !== JSON.stringify(usage))
+    await writeUsage(store, pruned);
+  return pruned;
+}
+
+export async function recordUsage(
+  store: string,
+  entry: string,
+  option: PasswordOptionType | undefined,
+): Promise<void> {
+  const now = Date.now();
+  const usage = await readUsage(store, now);
+  // A password followed by its OTP is one login, but the OTP still updates continuation state.
+  const continuation =
+    option === "otp" &&
+    usage.lastUsed?.password === entry &&
+    usage.lastUsed.option === "Password" &&
+    now - usage.lastUsed.timestamp <= CONTINUATION_MS;
+  if (!continuation) {
+    const previous = usage.entries.find((record) => record.entry === entry);
+    usage.entries = usage.entries.filter((record) => record.entry !== entry);
+    usage.entries.push({
+      entry,
+      score: Math.min(MAX_SCORE, usageScore(previous, now) + 1),
+      timestamp: now,
+    });
+  }
+  usage.entries.sort((a, b) => usageScore(b, now) - usageScore(a, now));
+  usage.entries = usage.entries.slice(0, MAX_ENTRIES);
+  usage.lastUsed = {
+    password: entry,
+    option:
+      option === "password" ? "Password" : option === "otp" ? "OTP" : "Other",
+    timestamp: now,
+  };
+  await writeUsage(store, usage);
+}
