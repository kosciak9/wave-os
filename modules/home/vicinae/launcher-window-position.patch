Subject: Place the launcher halfway through available vertical space

Use halfway placement in the generic QML and shared available-geometry C++
positioning paths, matching the centered placement provided by the Wayland
layer-shell path. The shared C++ path also covers macOS during show setup.

diff --git a/src/server/src/ui/qml/launcher/LauncherWindow.qml b/src/server/src/ui/qml/launcher/LauncherWindow.qml
--- a/src/server/src/ui/qml/launcher/LauncherWindow.qml
+++ b/src/server/src/ui/qml/launcher/LauncherWindow.qml
@@ -440,1 +440,1 @@
-            root.y = Screen.virtualY + (Screen.height - root.expandedHeight) / 3;
+            root.y = Screen.virtualY + (Screen.height - root.expandedHeight) / 2;
@@ -446,1 +446,1 @@
-            root.y = Screen.virtualY + (Screen.height - root.expandedHeight) / 3;
+            root.y = Screen.virtualY + (Screen.height - root.expandedHeight) / 2;
diff --git a/src/server/src/ui/windows/launcher-window.cpp b/src/server/src/ui/windows/launcher-window.cpp
--- a/src/server/src/ui/windows/launcher-window.cpp
+++ b/src/server/src/ui/windows/launcher-window.cpp
@@ -719,2 +719,2 @@ void LauncherWindow::positionOnCursorScreen() {
-  m_window->setPosition(avail.left() + (avail.width() - m_window->width()) / 2,
-                        avail.top() + (avail.height() - refHeight) / 3);
+  m_window->setPosition(avail.left() + (avail.width() - m_window->width()) / 2,
+                        avail.top() + (avail.height() - refHeight) / 2);
