{
	# Off: Caddy runs as root, and every Podman container reaches the host's loopback, where a
	# spoofed Host header passes the admin origin check. A new config takes a daemon restart.
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://renekton.dusky-diatonic.ts.net:18790 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy 127.0.0.1:18789
}

https://renekton.dusky-diatonic.ts.net:6080 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy 127.0.0.1:16080
}

https://tokens.wave.exposed {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	route {
		@outside not remote_ip 127.0.0.1 ::1 100.64.0.0/10 fd7a:115c:a1e0::/48
		respond @outside 403
		# The management page is what people open here; the URL stays the bare domain.
		rewrite / /management.html
		@management path /management.html /v8/management/*
		handle @management {
			reverse_proxy 127.0.0.1:8317
		}
		@inference path /v1/models /v1/chat/completions /v1/responses /v1/responses/compact /v1/messages /v1/messages/count_tokens /v1/quota
		handle @inference {
			reverse_proxy 127.0.0.1:8317
		}
		handle {
			respond 404
		}
	}
}

@MCP_GATEWAY_URL@ {
	tls {
		get_certificate tailscale
	}
	# mcp-proxy rejects requests whose Host is not its own listen address.
	reverse_proxy @MCP_GATEWAY_ADDR@ {
		header_up Host {upstream_hostport}
	}
}
