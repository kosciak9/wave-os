FROM docker.io/library/rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY src/ src/
RUN cargo test --locked && cargo build --release --locked

FROM docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /src/target/release/wave-slack-mirror /usr/local/bin/wave-slack-mirror
RUN mkdir -p /data /run/secrets && chmod 0700 /data && chown 65532:65532 /data
LABEL org.opencontainers.image.title="Standalone Slack mirror" \
      org.opencontainers.image.version="0.1.0" \
      io.wave-os.component="slack-mirror"
ENV HOME=/tmp
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/wave-slack-mirror"]
