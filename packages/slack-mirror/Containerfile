FROM docker.io/library/rust:1.99-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY src/ src/
RUN cargo test --locked && cargo build --release --locked

FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /src/target/release/wave-slack-mirror /usr/local/bin/wave-slack-mirror
RUN mkdir -p /data /run/secrets && chmod 0700 /data && chown 65532:65532 /data
LABEL org.opencontainers.image.title="Standalone Slack mirror" \
      org.opencontainers.image.version="0.1.0" \
      io.wave-os.component="slack-mirror"
ENV HOME=/tmp
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/wave-slack-mirror"]
