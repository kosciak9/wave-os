+/// Whether Gmail asked to slow down: a 429 or 5xx, or a 403 naming a
+/// per-second or per-minute rate limit. A daily quota stays a failure.
+fn is_rate_limited(err: &GmailClientStdError) -> bool {
+    let GmailClientStdError::Send(send) = err else {
+        return false;
+    };
+    if send.is_retryable() {
+        return true;
+    }
+    let GmailSendError::Api {
+        status: 403,
+        message,
+    } = send
+    else {
+        return false;
+    };
+    let message = message.to_lowercase();
+    message.contains("rate limit") || message.contains("per minute")
+}
