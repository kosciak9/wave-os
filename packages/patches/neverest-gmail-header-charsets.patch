+    // NOTE: Gmail answers headers with their RFC 2047 words intact, and
+    // io-pimdir's decoder reads every 8-bit charset but latin1 and cp1252 as
+    // UTF-8, so a Polish `iso-8859-2` subject lost its letters. mail-parser
+    // carries the charset tables.
+    let mut raw = String::new();
+    for name in ["Subject", "From", "To", "Cc", "Bcc"] {
+        if let Some(value) = header(name) {
+            let value = value.replace(['\r', '\n'], " ");
+            raw.push_str(&format!("{name}: {value}\r\n"));
+        }
+    }
+    raw.push_str("\r\n");
+    let parsed = MessageParser::default().parse_headers(raw.as_bytes());
+    let list = |address: Option<&mail_parser::Address>| -> Vec<Address> {
