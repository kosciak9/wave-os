 function safeError(err) {
   if (CONFIG.nodeEnv === 'production') {
+    // Explicit client errors come from route validation, not browser internals.
+    if (err instanceof StaleRefsError || (Number.isInteger(err.statusCode) && err.statusCode >= 400 && err.statusCode < 500)) {
+      return err.message;
+    }
