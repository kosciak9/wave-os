+++ b/src/shared/message/archive.rs
@@ -0,0 +1,58 @@
+//! # Message archive
+//!
+//! Archive inbox messages without sending them to the trash.
+
+use std::fmt;
+
+use anyhow::Result;
+use clap::Parser;
+use pimalaya_cli::printer::Printer;
+use schemars::JsonSchema;
+use serde::Serialize;
+
+use crate::{
+    account::context::Account,
+    shared::{client::EmailClient, flag::arg::MessageIdsArg},
+};
+
+/// Archive messages from the active account's inbox.
+///
+/// Gmail removes only the INBOX label. A Neverest Gmail pimdir replica
+/// stages that removal for the next sync; it needs no All Mail collection.
+/// Other backends move to `mailbox.alias.archive` or the archive role,
+/// refusing a missing archive mailbox before changing any messages.
+#[derive(Debug, Parser)]
+pub struct MessageArchiveCommand {
+    #[command(flatten)]
+    pub message_ids: MessageIdsArg,
+}
+
+impl MessageArchiveCommand {
+    /// Archives the messages and reports how many were processed.
+    pub fn execute(
+        self,
+        printer: &mut impl Printer,
+        account: &mut Account,
+        client: &mut EmailClient,
+    ) -> Result<()> {
+        let ids: Vec<&str> = self.message_ids.inner.iter().map(String::as_str).collect();
+        let count = client.archive_messages(account, &ids)?;
+        printer.out(ArchiveReport {
+            action: "archived",
+            count,
+        })
+    }
+}
+
+/// The archive output, including actions staged for the next pimdir sync.
+#[derive(Debug, Serialize, JsonSchema)]
+pub(crate) struct ArchiveReport {
+    action: &'static str,
+    count: usize,
+}
+
+impl fmt::Display for ArchiveReport {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "Successfully archived {} message(s)", self.count)
+    }
+}
