@@ -0,0 +1,39 @@
+//! Raw pimdir queue status, without reading message bodies.
+
+use std::fmt;
+
+use anyhow::Result;
+use clap::Parser;
+use pimalaya_cli::printer::Printer;
+use schemars::JsonSchema;
+use serde::Serialize;
+
+use crate::pimdir::client::PimdirClient;
+
+/// Count all outstanding actions across the store, including parked actions.
+///
+/// Includes every action kind and producer, not only queued message creations.
+/// A shared store counts other accounts too, conservatively refusing to report
+/// a fully drained queue while any writes remain outstanding.
+#[derive(Debug, Parser)]
+pub struct PimdirQueueStatusCommand;
+
+impl PimdirQueueStatusCommand {
+    /// Reports how many raw queue actions remain outstanding.
+    pub fn execute(self, printer: &mut impl Printer, client: &mut PimdirClient) -> Result<()> {
+        printer.out(PimdirQueueStatus {
+            pending: client.pending_actions_count()?,
+        })
+    }
+}
+
+#[derive(Debug, Serialize, JsonSchema)]
+pub struct PimdirQueueStatus {
+    pub pending: usize,
+}
+
+impl fmt::Display for PimdirQueueStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{} outstanding pimdir action(s)", self.pending)
+    }
+}
