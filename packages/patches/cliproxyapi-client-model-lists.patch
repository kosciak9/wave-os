 func (h *ClaudeCodeAPIHandler) ClaudeModels(c *gin.Context) {
 	cfg := h.CurrentConfig()
 	disableCloaking := cfg != nil && cfg.ClaudeCode.DisableCloakingModelList
-	h.WriteModelListResponse(c, h.HandlerType(), claudemodels.BuildResponse(h.Models(), disableCloaking))
+	h.WriteModelListResponse(c, h.HandlerType(), claudemodels.BuildResponse(anthropicSubscriptionModels(h.Models()), disableCloaking))
+}
+
+// anthropicSubscriptionModels keeps the models the gateway serves from Anthropic
+// itself: owned by Anthropic and without a provider prefix such as zen/.
+// Claude Code lists only these; other clients keep the full catalog.
+func anthropicSubscriptionModels(models []map[string]any) []map[string]any {
+	kept := make([]map[string]any, 0, len(models))
+	for _, model := range models {
+		id, _ := model["id"].(string)
+		if owner, _ := model["owned_by"].(string); owner == "anthropic" && !strings.Contains(id, "/") {
+			kept = append(kept, model)
+		}
+	}
+	return kept
 }
 
