-/** Select an option by its accessible label, then by its HTML value. */
+/** Resolve label or value without attempting a mutation. */
 export async function selectOption(locator, option) {
+  const match = await locator.evaluate((element, requested) => {
+    if (element.tagName !== 'SELECT') return null;
+    const matches = Array.from(element.options).filter(item => item.value === requested || item.label === requested);
+    return matches.length === 1 ? { value: matches[0].value } : null;
+  }, option, { timeout: 3000 });
+  if (!match) {
+    const error = new Error('Option must uniquely match one native select label or value. Call snapshot to inspect the current options.');
+    error.statusCode = 422;
+    error.mutationOutcome = 'not_dispatched';
+    throw error;
+  }
   try {
-    return await locator.selectOption({ label: option });
-  } catch (labelError) {
-    try {
-      return await locator.selectOption({ value: option });
-    } catch {
-      throw labelError;
-    }
+    return await locator.selectOption({ value: match.value }, { timeout: 5000 });
+  } catch (error) {
+    error.mutationOutcome = 'unknown';
+    throw error;
   }
 }
