+// Operator-only barrier. A lock timeout can release the lock while its original
+// promise is still running, so the lock alone cannot establish settlement.
+app.get('/tabs/:tabId/settlement', (req, res, next) => {
+  if (!CONFIG.apiKey && !CONFIG.accessKey) return res.status(403).json({ error: 'Settlement requires API authentication' });
+  next();
+}, authMiddleware(), async (req, res) => {
+  const { tabId } = req.params;
+  const { userId } = req.query;
+  if (typeof userId !== 'string' || !userId) return res.status(400).json({ error: 'userId required' });
+  const key = normalizeUserId(userId);
+  const hasPending = () => {
+    const user = userConcurrency.get(key);
+    return (tabOperations.get(tabId)?.size || 0) > 0 || Boolean(user && (user.active > 0 || user.queue.length > 0));
+  };
+  const session = sessions.get(key);
+  if (!session || !findTab(session, tabId)) {
+    const state = hasPending() ? 'pending' : 'closed';
+    return res.status(state === 'pending' ? 409 : 200).json({ ok: true, state });
+  }
+  try {
+    const state = await withTabLock(tabId, () => {
+      // Recheck ownership after waiting for the queue; destruction drains locks.
+      if (hasPending()) return 'pending';
+      if (sessions.get(key) !== session) return 'closed';
+      const found = findTab(session, tabId);
+      if (!found) return 'closed';
+      return found.tabState.page.isClosed() ? 'closed' : 'settled';
+    }, HANDLER_TIMEOUT_MS, undefined, false);
+    return res.status(state === 'pending' ? 409 : 200).json({ ok: true, state });
+  } catch (err) {
+    return res.status(409).json({ ok: false, state: 'pending' });
+  }
+});
