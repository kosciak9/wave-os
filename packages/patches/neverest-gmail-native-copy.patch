+    /// Files an inbox message without importing it; trashing removes INBOX.
+    pub fn copy_inbox_item(&mut self, to: &str, id: &str) -> Result<()> {
+        let label = self.label_id(to)?;
+        let remove = if label == TRASH {
+            vec!["INBOX".to_string()]
+        } else {
+            Vec::new()
+        };
+        self.modify(&[id], &[label], &remove)
+            .with_context(|| format!("Copy message {id} to {to} error"))
+    }
