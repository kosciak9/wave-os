+// accountCapPhrases are the wordings a client reads as a permanent account
+// cap rather than a temporary throttle. A cooldown always expires, so these
+// phrases must not reach a retryable response body.
+//
+// Each pattern matches the way the client matches it, so the wording is
+// rewritten only where the client would have read it as a cap. A separator
+// between the words of a phrase is optional where the client allows one,
+// because the client reads "quota exceeded", "quota-exceeded" and
+// "quotaexceeded" alike. A phrase the client only reads with a space is
+// matched with a space only: the client reads "usage limit" but not the
+// underscored code "usage_limit_reached", and rewriting that code would erase
+// the identity of the cause.
+var accountCapPhrases = []struct {
+	pattern     *regexp.Regexp
+	replacement string
+}{
+	{pattern: regexp.MustCompile(`(?i)insufficient[-_\s]?(?:quota|balance)`), replacement: "insufficient allowance"},
+	{pattern: regexp.MustCompile(`(?i)quota[-_\s]?exceeded`), replacement: "allowance exceeded"},
+	{pattern: regexp.MustCompile(`(?i)budget exceeded`), replacement: "allowance exceeded"},
+	{pattern: regexp.MustCompile(`(?i)limit exhausted`), replacement: "allowance exhausted"},
+	{pattern: regexp.MustCompile(`(?i)usage limit`), replacement: "usage allowance"},
+	{pattern: regexp.MustCompile(`(?i)package has expired`), replacement: "package expired"},
+	{pattern: regexp.MustCompile(`(?i)plan does not yet include`), replacement: "plan does not yet cover"},
