+	}
+	if isUpperCase(match[0]) {
+		return capitalizeFirst(replacement)
+	}
+	return replacement
+}
+
+func isUpperCase(char byte) bool {
+	return char >= 'A' && char <= 'Z'
+}
+
+func capitalizeFirst(text string) string {
+	if text == "" {
+		return text
+	}
+	return strings.ToUpper(text[:1]) + text[1:]
+}
