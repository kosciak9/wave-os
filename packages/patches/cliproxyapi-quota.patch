+// depletedAllowanceCooldown turns a depleted plan allowance into a model
+// cooldown. The upstream failure wording can be read by a client as a
+// permanent rejection that stops it from retrying, while the cooldown answers
+// with a recovery deadline the client can wait for.
+//
+// It reports false when the failure carries no recovery deadline, because
+// without one there is nothing the client could wait for.
+func depletedAllowanceCooldown(model, provider string, err error) (error, bool) {
+	resetIn, ok := quotaLimitResetIn(err)
+	if !ok {
+		return nil, false
+	}
+	return newModelCooldownErrorWithCause(model, provider, resetIn, err), true
+}
+
+// quotaLimitResetIn reports how long a depleted plan allowance still blocks
+// the model, when the upstream failure carries that deadline. The upstream
+// codex failure reports it as "resets_in_seconds" or "resets_at".
+func quotaLimitResetIn(err error) (time.Duration, bool) {
+	if err == nil {
+		return 0, false
+	}
+	summary := ExtractUpstreamErrorSummary(err.Error())
+	if summary == "" {
+		return 0, false
+	}
+	if !mentionsDepletedAllowance(summary) {
+		return 0, false
+	}
+	if retryAfter := retryAfterFromError(err); retryAfter != nil && *retryAfter > 0 {
+		return *retryAfter, true
+	}
+	return 0, false
+}
+
+// mentionsDepletedAllowance reports whether the upstream failure reports a
+// depleted plan allowance. The upstream codex failure names it with the code
+// "usage_limit_reached", which carries an underscore, so a client that reads
+// the space-separated phrase does not match it.
+func mentionsDepletedAllowance(summary string) bool {
+	lower := strings.ToLower(summary)
+	return strings.Contains(lower, "usage_limit_reached") ||
+		strings.Contains(lower, "usage limit") ||
+		strings.Contains(lower, "quota_exceeded") ||
+		strings.Contains(lower, "quota exceeded")
+}
