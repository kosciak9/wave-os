+
+// neutralizeAccountCapWording rewrites the account-cap phrases of an upstream
+// summary so the reason stays readable while the wording no longer reads as a
+// permanent rejection.
+func neutralizeAccountCapWording(text string) string {
+	if text == "" {
+		return text
+	}
+	out := text
+	for _, phrase := range accountCapPhrases {
+		out = phrase.pattern.ReplaceAllStringFunc(out, func(match string) string {
+			return preserveLeadingCase(match, phrase.replacement)
+		})
+	}
+	return out
