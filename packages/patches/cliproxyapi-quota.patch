index 0000000..830c25d
--- /dev/null
+++ b/internal/api/quota_endpoint.go
@@ -0,0 +1,861 @@
+package api
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"net/url"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	log "github.com/sirupsen/logrus"
+)
+
+const quotaTTL = 5 * time.Minute
+const maxQuotaLimits = 32
+
+type quotaLimit struct {
+	legacyLabel      string
+	Label            string     `json:"label"`
+	RemainingPercent *float64   `json:"remaining_percent,omitempty"`
+	Remaining        *float64   `json:"remaining,omitempty"`
+	Total            *float64   `json:"total,omitempty"`
+	Unit             string     `json:"unit,omitempty"`
+	ResetAt          int64      `json:"reset_at,omitempty"`
+	WindowSeconds    float64    `json:"window_seconds,omitempty"`
+	Pace             *quotaPace `json:"pace,omitempty"`
+}
+
+type quotaAccount struct {
+	ID        string       `json:"id"`
+	Provider  string       `json:"provider"`
+	Label     string       `json:"label"`
+	Plan      string       `json:"plan,omitempty"`
+	Scope     string       `json:"scope,omitempty"`
+	Status    string       `json:"status"`
+	UpdatedAt int64        `json:"updated_at,omitempty"`
+	Stale     bool         `json:"stale"`
+	Limits    []quotaLimit `json:"limits"`
+	Usage     *quotaUsage  `json:"usage,omitempty"`
+}
+
+type quotaObservation struct {
+	account quotaAccount
+	checked time.Time
+	version uint64
+	epoch   uint64
+}
+
+type quotaEndpoint struct {
+	manager    *auth.Manager
+	config     func() *config.Config
+	plugins    *pluginhost.Host
+	next       http.Handler
+	key        []byte
+	keyHash    [32]byte
+	mu         sync.Mutex
+	cache      map[string]quotaObservation
+	refreshing bool
+	started    time.Time
+	usageMu    sync.Mutex
+	usage      map[string][]quotaUsageBucket
+}
+
+func newQuotaEndpoint(manager *auth.Manager, plugins *pluginhost.Host, next http.Handler) *quotaEndpoint {
+	q := &quotaEndpoint{manager: manager, plugins: plugins, next: next, cache: make(map[string]quotaObservation), started: time.Now(), usage: make(map[string][]quotaUsageBucket)}
+	// Read exactly once. Rotation requires restarting the server; failures never enable anonymous access.
+	if path := os.Getenv("CLIPROXYAPI_QUOTA_KEY_FILE"); path != "" {
+		info, err := os.Stat(path)
+		if err != nil || !info.Mode().IsRegular() {
+			return q
+		}
+		if file, err := os.Open(path); err == nil {
+			info, statErr := file.Stat()
+			if statErr != nil || !info.Mode().IsRegular() {
+				_ = file.Close()
+				return q
+			}
+			data, readErr := io.ReadAll(io.LimitReader(file, 4098))
+			_ = file.Close()
+			key := strings.TrimSpace(string(data))
+			valid := readErr == nil && len(data) <= 4097 && len(key) >= 32 && len(key) <= 4096
+			for _, char := range key {
+				valid = valid && char >= 33 && char <= 126
+			}
+			if valid {
+				q.key = []byte(key)
+				q.keyHash = sha256.Sum256(q.key)
+				coreusage.RegisterNamedPlugin("quota-usage", q)
+				if manager != nil {
+					go q.recoverCooldowns()
+				}
+			}
+		}
+	}
+	return q
+}
+
+func (q *quotaEndpoint) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path != "/v1/quota" {
+		q.next.ServeHTTP(w, r)
+		return
+	}
+	// This boundary deliberately precedes Gin, request logging and inference/management gates.
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Type", "application/json")
+	if len(q.key) == 0 || q.manager == nil {
+		w.WriteHeader(http.StatusServiceUnavailable)
+		_, _ = io.WriteString(w, `{"error":"quota unavailable"}`)
+		return
+	}
+	headers := r.Header.Values("Authorization")
+	var supplied string
+	if len(headers) == 1 && strings.HasPrefix(headers[0], "Bearer ") {
+		supplied = strings.TrimPrefix(headers[0], "Bearer ")
+	}
+	digest := sha256.Sum256([]byte(supplied))
+	if supplied == "" || subtle.ConstantTimeCompare(digest[:], q.keyHash[:]) != 1 {
+		w.WriteHeader(http.StatusUnauthorized)
+		_, _ = io.WriteString(w, `{"error":"unauthorized"}`)
+		return
+	}
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		_, _ = io.WriteString(w, `{"error":"method not allowed"}`)
+		return
+	}
+	q.snapshot(w, r.URL.Query().Get("schema") == "2")
+}
+
+func (q *quotaEndpoint) snapshot(w http.ResponseWriter, schema2 bool) {
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Type", "application/json")
+	if q.manager == nil {
+		w.WriteHeader(http.StatusServiceUnavailable)
+		_, _ = io.WriteString(w, `{"error":"quota unavailable"}`)
+		return
+	}
+	now := time.Now()
+	groups := make(map[string]*auth.Auth)
+	for _, account := range q.manager.List() {
+		if account == nil || !quotaInventoryAccount(account) {
+			continue
+		}
+		id := q.accountID(account)
+		previous := groups[id]
+		available := quotaLifecycleStatus(account, now) == ""
+		if previous == nil || (available && quotaLifecycleStatus(previous, now) != "") || (available == (quotaLifecycleStatus(previous, now) == "") && account.ID < previous.ID) {
+			groups[id] = account
+		}
+	}
+	accounts := make([]*auth.Auth, 0, len(groups))
+	for _, account := range groups {
+		accounts = append(accounts, account)
+	}
+	sort.Slice(accounts, func(i, j int) bool { return accounts[i].ID < accounts[j].ID })
+	result := make([]quotaAccount, 0, len(accounts))
+	counts := make(map[string]int)
+	seen := make(map[string]bool)
+	refresh := false
+	q.mu.Lock()
+	for _, account := range accounts {
+		if account == nil {
+			continue
+		}
+		id := q.accountID(account)
+		if seen[id] {
+			continue
+		}
+		seen[id] = true
+		provider := quotaProviderLabel(quotaAccountProvider(account))
+		counts[provider]++
+		item := quotaAccount{ID: id, Provider: provider, Label: fmt.Sprintf("%s %d", provider, counts[provider]), Status: "unavailable", Stale: true, Limits: []quotaLimit{}}
+		if schema2 {
+			item.Label = quotaAccountLabel(account, provider)
+			item.Scope = "unknown"
+		}
+		cached, exists := q.cache[id]
+		if exists && cached.version == account.CredentialVersion && cached.epoch == account.RegistrationEpoch {
+			item.Status, item.UpdatedAt, item.Limits = cached.account.Status, cached.account.UpdatedAt, cached.account.Limits
+			item.Stale = cached.account.Stale || now.Sub(cached.checked) >= quotaTTL
+		} else {
+			exists = false
+		}
+		if status := quotaLifecycleStatus(account, now); status != "" {
+			item.Status = status
+			item.Limits = []quotaLimit{}
+			item.Stale = false
+			if status == "disabled" || status == "unavailable" {
+				delete(q.cache, id)
+			}
+			if quotaRecoverableCooldown(account, now) && (!exists || now.Sub(cached.checked) >= quotaTTL) {
+				refresh = true
+			}
+		} else if !exists || now.Sub(cached.checked) >= quotaTTL {
+			refresh = true
+		}
+		if len(item.Limits) > maxQuotaLimits {
+			item.Limits = item.Limits[:maxQuotaLimits]
+		}
+		// Pace is a read-time projection, never written back into the shared cache.
+		item.Limits = append([]quotaLimit{}, item.Limits...)
+		if schema2 {
+			if provider == "zen" && len(item.Limits) == 0 && q.config != nil && quotaZenFreeOnly(account, q.config()) {
+				item.Plan, item.Scope = "Zen Free", "free"
+			}
+			if len(item.Limits) > 0 {
+				switch provider {
+				case "go", "zen":
+					item.Plan, item.Scope = "Go", "subscription"
+				case "codex", "claude", "meta":
+					item.Scope = "subscription"
+				case "xai":
+					item.Scope = "credits"
+				}
+			}
+			for i := range item.Limits {
+				item.Limits[i].Pace = quotaLimitPace(item.Limits[i], now, item.Stale || item.Status != "ok")
+			}
+		} else {
+			for i := range item.Limits {
+				if item.Limits[i].legacyLabel != "" {
+					item.Limits[i].Label = item.Limits[i].legacyLabel
+				}
+				item.Limits[i].WindowSeconds = 0
+				item.Limits[i].Pace = nil
+			}
+		}
+		item.Usage = q.usageSnapshot(id, now)
+		result = append(result, item)
+	}
+	for id := range q.cache {
+		if !seen[id] {
+			delete(q.cache, id)
+		}
+	}
+	q.usageMu.Lock()
+	for id := range q.usage {
+		if !seen[id] {
+			delete(q.usage, id)
+		}
+	}
+	q.usageMu.Unlock()
+	if refresh && !q.refreshing {
+		q.refreshing = true
+		go q.refresh(accounts)
+	}
+	q.mu.Unlock()
+	if schema2 {
+		_ = json.NewEncoder(w).Encode(struct {
+			Schema    int            `json:"schema"`
+			UpdatedAt int64          `json:"updated_at"`
+			Accounts  []quotaAccount `json:"accounts"`
+			Summary   quotaSummary   `json:"summary"`
+		}{2, now.Unix(), result, summarizeQuota(result)})
+		return
+	}
+	_ = json.NewEncoder(w).Encode(struct {
+		Accounts  []quotaAccount `json:"accounts"`
+		UpdatedAt int64          `json:"updated_at"`
+	}{result, now.Unix()})
+}
+
+func (q *quotaEndpoint) accountID(account *auth.Auth) string {
+	hash := hmac.New(sha256.New, q.key)
+	provider := quotaAccountProvider(account)
+	identity := account.ID
+	// Console keys reused across protocol adapters identify one account; OAuth IDs stay distinct.
+	if provider == "go" || provider == "zen" {
+		provider = "opencode"
+		key := quotaAPIKey(account)
+		if key != "" {
+			identity = "api-key\x00" + key
+		}
+	}
+	_, _ = io.WriteString(hash, provider+"\x00"+identity)
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func quotaAccountProvider(account *auth.Auth) string {
+	if account.AuthKind() != auth.AuthKindOAuth || quotaAPIKey(account) != "" {
+		prefix := strings.ToLower(strings.TrimSpace(account.Prefix))
+		if prefix == "go" || prefix == "zen" {
+			return prefix
+		}
+		if base, err := url.Parse(account.Attributes["base_url"]); err == nil && base.Scheme == "https" && base.Host == "opencode.ai" {
+			path := strings.TrimRight(base.Path, "/")
+			if path == "/inference/go" || path == "/inference/go/v1" {
+				return "go"
+			}
+			if path == "/inference" || path == "/inference/v1" {
+				return "zen"
+			}
+		}
+	}
+	return account.Provider
+}
+
+func quotaProviderLabel(provider string) string {
+	switch provider {
+	case "codex", "claude", "meta", "xai", "antigravity", "gemini", "gemini-cli", "aistudio", "vertex", "kimi", "qwen", "iflow", "openai", "openai-compatible", "go", "zen", "opencode", "devin":
+		return provider
+	default:
+		return "other"
+	}
+}
+
+func quotaLifecycleStatus(account *auth.Auth, now time.Time) string {
+	if account.Disabled || account.Status == auth.StatusDisabled {
+		return "disabled"
+	}
+	if account.Quota.NextRecoverAt.After(now) || account.NextRetryAfter.After(now) {
+		return "cooldown"
+	}
+	if account.Status == auth.StatusError {
+		return "error"
+	}
+	if account.Status == auth.StatusPending || account.Status == auth.StatusRefreshing {
+		return "unavailable"
+	}
+	return ""
+}
+
+// quotaRecoverableCooldown reports whether every active cooldown on the account
+// comes from a quota limit, so an upstream snapshot can prove it lifted early.
+func quotaRecoverableCooldown(account *auth.Auth, now time.Time) bool {
+	quotaReason := func(quota auth.QuotaState) bool {
+		return quota.Exceeded && (quota.Reason == "quota" || quota.Reason == "credential_quota")
+	}
+	active := false
+	if account.Quota.NextRecoverAt.After(now) || account.NextRetryAfter.After(now) {
+		if !quotaReason(account.Quota) {
+			return false
+		}
+		active = true
+	}
+	for _, state := range account.ModelStates {
+		if state == nil || !(state.NextRetryAfter.After(now) || state.Quota.NextRecoverAt.After(now)) {
+			continue
+		}
+		if !quotaReason(state.Quota) {
+			return false
+		}
+		active = true
+	}
+	return active
+}
+
+func quotaLimitsAvailable(limits []quotaLimit) bool {
+	for _, limit := range limits {
+		if limit.RemainingPercent == nil || *limit.RemainingPercent <= 0 {
+			return false
+		}
+	}
+	return len(limits) > 0
+}
+
+// recoverCooldowns re-checks quota-cooled accounts without waiting for a
+// snapshot request; the cache TTL bounds how often each one hits upstream.
+func (q *quotaEndpoint) recoverCooldowns() {
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	for range ticker.C {
+		now := time.Now()
+		accounts := []*auth.Auth{}
+		for _, account := range q.manager.List() {
+			if account != nil && quotaInventoryAccount(account) && quotaLifecycleStatus(account, now) == "cooldown" && quotaRecoverableCooldown(account, now) {
+				accounts = append(accounts, account)
+			}
+		}
+		q.mu.Lock()
+		start := len(accounts) > 0 && !q.refreshing
+		if start {
+			q.refreshing = true
+		}
+		q.mu.Unlock()
+		if start {
+			q.refresh(accounts)
+		}
+	}
+}
+
+func (q *quotaEndpoint) refresh(accounts []*auth.Auth) {
+	defer func() { q.mu.Lock(); q.refreshing = false; q.mu.Unlock() }()
+	jobs := make(chan *auth.Auth)
+	var workers sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for account := range jobs {
+				id := q.accountID(account)
+				q.mu.Lock()
+				cached, exists := q.cache[id]
+				q.mu.Unlock()
+				if exists && cached.version == account.CredentialVersion && cached.epoch == account.RegistrationEpoch && time.Since(cached.checked) < quotaTTL {
+					continue
+				}
+				lifecycle := quotaLifecycleStatus(account, time.Now())
+				recoverable := lifecycle == "cooldown" && quotaRecoverableCooldown(account, time.Now())
+				if lifecycle != "" && !recoverable {
+					continue
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+				limits, status := q.fetch(ctx, account)
+				cancel()
+				now := time.Now()
+				// Upstream windows can reset before the recorded Retry-After deadline.
+				if recoverable && status == "ok" && quotaLimitsAvailable(limits) {
+					if _, _, err := q.manager.ResetQuota(context.Background(), account.ID); err != nil {
+						log.WithError(err).Warn("quota: failed to clear recovered cooldown")
+					} else {
+						log.WithField("provider", account.Provider).Info("quota: upstream quota recovered, cooldown cleared")
+					}
+				}
+				observation := quotaObservation{account: quotaAccount{Status: status, UpdatedAt: now.Unix(), Stale: status == "error", Limits: limits}, checked: now, version: account.CredentialVersion, epoch: account.RegistrationEpoch}
+				if status == "error" && exists && cached.version == account.CredentialVersion && cached.epoch == account.RegistrationEpoch && len(cached.account.Limits) > 0 && (cached.account.Status == "ok" || cached.account.Status == "error") {
+					observation.account.Limits = cached.account.Limits
+					observation.account.UpdatedAt = cached.account.UpdatedAt
+				}
+				if len(observation.account.Limits) > maxQuotaLimits {
+					observation.account.Limits = observation.account.Limits[:maxQuotaLimits]
+				}
+				q.mu.Lock()
+				q.cache[id] = observation
+				q.mu.Unlock()
+			}
+		}()
+	}
+	seen := make(map[string]bool)
+	for _, account := range accounts {
+		if account != nil {
+			id := q.accountID(account)
+			if !seen[id] {
+				seen[id] = true
+				jobs <- account
+			}
+		}
+	}
+	close(jobs)
+	workers.Wait()
+}
+
+func (q *quotaEndpoint) fetch(ctx context.Context, account *auth.Auth) ([]quotaLimit, string) {
+	limits := []quotaLimit{}
+	provider := quotaAccountProvider(account)
+	// Prefer the host's registered quota capability, never its management routes or reset operations.
+	if q.plugins != nil && provider != "go" && provider != "zen" {
+		response, handled, err := q.plugins.FetchQuota(ctx, pluginapi.QuotaFetchRequest{AuthID: account.ID, Provider: account.Provider, Metadata: account.Metadata, Attributes: account.Attributes})
+		if handled {
+			if err != nil {
+				return limits, "error"
+			}
+			for i, group := range response.Groups {
+				for j, bucket := range group.Buckets {
+					if len(limits) >= maxQuotaLimits {
+						return limits, quotaLimitsStatus(limits)
+					}
+					if percent := quotaNumber(bucket.RemainingFraction * 100); percent != nil {
+						groupName := quotaSafeLimitText(account, group.DisplayName)
+						windowName := quotaSafeLimitText(account, bucket.Window)
+						label := quotaBucketLabel(groupName, fmt.Sprintf("group %d window %d", i+1, j+1), windowName)
+						if quotaSafeLimitText(account, label) == "" {
+							label = fmt.Sprintf("group %d window %d", i+1, j+1)
+						}
+						limits = append(limits, quotaLimit{legacyLabel: fmt.Sprintf("group %d window %d", i+1, j+1), Label: label, RemainingPercent: quotaPercent(*percent), ResetAt: quotaReset(bucket.ResetTime), WindowSeconds: quotaCadenceSeconds(windowName)})
+					}
+				}
+			}
+			return limits, quotaLimitsStatus(limits)
+		}
+	}
+	if account.AuthKind() == auth.AuthKindAPIKey && provider != "meta" && provider != "go" && provider != "zen" {
+		return limits, "unavailable"
+	}
+	method, url, body := http.MethodGet, "", ""
+	switch provider {
+	case "go", "zen":
+		if quotaAPIKey(account) == "" {
+			return limits, "unavailable"
+		}
+		url = "https://opencode.ai/inference/go/v1/usage"
+	case "codex":
+		url = "https://chatgpt.com/backend-api/wham/usage"
+	case "claude":
+		url = "https://api.anthropic.com/api/oauth/usage"
+	case "meta":
+		token, _ := account.Metadata["dca_token"].(string)
+		if token == "" {
+			token = account.Attributes["dca_token"]
+		}
+		if token == "" {
+			token, _ = account.Metadata["access_token"].(string)
+		}
+		if token == "" {
+			token = account.Attributes["access_token"]
+		}
+		token = strings.TrimSpace(token)
+		if !strings.HasPrefix(token, "dca:") || len(token) <= 4 || strings.ContainsAny(token, " \t\r\n") {
+			return limits, "unavailable"
+		}
+		method, url, body = http.MethodPost, "https://api.meta.ai/muse-code/key", "{}"
+	case "xai":
+		url = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
+	case "antigravity":
+		project, _ := account.Metadata["project_id"].(string)
+		if project == "" {
+			project = account.Attributes["project_id"]
+		}
+		if project == "" {
+			return limits, "unavailable"
+		}
+		encoded, _ := json.Marshal(map[string]string{"project": project})
+		method, url, body = http.MethodPost, "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary", string(encoded)
+	default:
+		return limits, "unavailable"
+	}
+	req, err := http.NewRequestWithContext(ctx, method, url, strings.NewReader(body))
+	if err != nil {
+		return limits, "error"
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+	if provider == "claude" {
+		req.Header.Set("anthropic-beta", "oauth-2025-04-20")
+		req.Header.Set("User-Agent", "claude-cli/2.1.280 (external, cli)")
+	}
+	if provider == "codex" {
+		req.Header.Set("User-Agent", "codex-tui/0.149.1")
+		if accountID, ok := account.Metadata["account_id"].(string); ok {
+			req.Header.Set("Chatgpt-Account-Id", accountID)
+		}
+	}
+	if provider == "meta" {
+		req.Header.Set("x-api-version", "1.0.0")
+	}
+	if provider == "xai" {
+		req.Header.Set("x-xai-token-auth", "xai-grok-cli")
+		req.Header.Set("x-grok-client-version", "1.0.46")
+		req.Header.Set("User-Agent", "grok-pager/1.0.46 grok-shell/1.0.46 (macos; aarch64)")
+		if userID, ok := account.Metadata["user_id"].(string); ok {
+			req.Header.Set("x-userid", userID)
+		}
+	}
+	urls := []string{url}
+	if provider == "xai" {
+		urls = append(urls, "https://cli-chat-proxy.grok.com/v1/billing")
+	}
+	if provider == "antigravity" {
+		urls = append(urls, "https://daily-cloudcode-pa.sandbox.googleapis.com/v1internal:retrieveUserQuotaSummary", "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary")
+	}
+	status := "unavailable"
+	for _, candidate := range urls {
+		request := req.Clone(ctx)
+		request.URL, _ = req.URL.Parse(candidate)
+		request.Body, _ = req.GetBody()
+		parsed, observedStatus := q.readQuota(ctx, account, request)
+		if observedStatus == "error" {
+			status = "error"
+		}
+		for _, limit := range parsed {
+			duplicate := false
+			for _, existing := range limits {
+				if existing.Label == limit.Label {
+					duplicate = true
+					break
+				}
+			}
+			if !duplicate && len(limits) < maxQuotaLimits {
+				limits = append(limits, limit)
+			}
+		}
+		if provider == "antigravity" && len(limits) > 0 {
+			break
+		}
+	}
+	if len(limits) > 0 {
+		return limits, "ok"
+	}
+	return limits, status
+}
+
+func (q *quotaEndpoint) readQuota(ctx context.Context, account *auth.Auth, req *http.Request) ([]quotaLimit, string) {
+	limits := []quotaLimit{}
+	response, err := q.manager.HttpRequest(ctx, account, req)
+	if err != nil {
+		return limits, "error"
+	}
+	if response == nil || response.Body == nil {
+		return limits, "error"
+	}
+	defer response.Body.Close()
+	if response.StatusCode == http.StatusNotFound || response.StatusCode == http.StatusForbidden {
+		return limits, "unavailable"
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return limits, "error"
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
+	if err != nil || len(data) > 1<<20 {
+		return limits, "error"
+	}
+	var payload map[string]any
+	if json.Unmarshal(data, &payload) != nil || payload == nil {
+		return limits, "error"
+	}
+	limits = parseQuotaLimits(quotaAccountProvider(account), payload, time.Now())
+	for i := range limits {
+		if label := quotaSafeLimitText(account, limits[i].Label); label != "" {
+			limits[i].Label = label
+		} else {
+			limits[i].Label = fmt.Sprintf("window %d", i+1)
+		}
+	}
+	return limits, quotaLimitsStatus(limits)
+}
+
+func quotaLimitsStatus(limits []quotaLimit) string {
+	if len(limits) == 0 {
+		return "unavailable"
+	}
+	return "ok"
+}
+
+func quotaNumber(value any) *float64 {
+	var number float64
+	switch value := value.(type) {
+	case float64:
+		number = value
+	case string:
+		parsed, err := strconv.ParseFloat(value, 64)
+		if err != nil {
+			return nil
+		}
+		number = parsed
+	default:
+		return nil
+	}
+	if math.IsNaN(number) || math.IsInf(number, 0) || number < 0 {
+		return nil
+	}
+	return &number
+}
+
+func quotaPercent(number float64) *float64 {
+	number = math.Max(0, math.Min(100, number))
+	return &number
+}
+
+func quotaReset(value any) int64 {
+	if number := quotaNumber(value); number != nil && *number > 0 && *number < 1e11 {
+		return int64(*number)
+	}
+	if text, ok := value.(string); ok {
+		if parsed, err := time.Parse(time.RFC3339Nano, text); err == nil && parsed.Unix() > 0 {
+			return parsed.Unix()
+		}
+	}
+	return 0
+}
+
+func quotaObject(value any) map[string]any { object, _ := value.(map[string]any); return object }
+
+func quotaWindowLabel(window map[string]any, fallback string) string {
+	seconds := quotaNumber(window["limit_window_seconds"])
+	if seconds == nil || *seconds <= 0 || *seconds > 365*24*60*60 || math.Trunc(*seconds) != *seconds {
+		return fallback
+	}
+	duration := int64(*seconds)
+	for _, unit := range []struct {
+		seconds int64
+		label   string
+	}{{86400, "d"}, {3600, "h"}, {60, "m"}, {1, "s"}} {
+		if duration%unit.seconds == 0 {
+			return strconv.FormatInt(duration/unit.seconds, 10) + unit.label
+		}
+	}
+	return fallback
+}
+
+func parseQuotaLimits(provider string, payload map[string]any, now time.Time) []quotaLimit {
+	limits := []quotaLimit{}
+	addUsed := func(label string, window map[string]any, field, reset string) {
+		if used := quotaNumber(window[field]); used != nil {
+			limit := quotaLimit{Label: label, RemainingPercent: quotaPercent(100 - *used), ResetAt: quotaReset(window[reset])}
+			if limit.ResetAt == 0 {
+				if offset := quotaNumber(window["reset_after_seconds"]); offset != nil && *offset < 1e9 {
+					limit.ResetAt = now.Unix() + int64(*offset)
+				}
+			}
+			limit.WindowSeconds = quotaWindowSeconds(window, limit.ResetAt)
+			limits = append(limits, limit)
+		}
+	}
+	switch provider {
+	case "codex":
+		for _, key := range []string{"rate_limit", "code_review_rate_limit"} {
+			rate := quotaObject(payload[key])
+			for i, window := range []string{"primary_window", "secondary_window"} {
+				value := quotaObject(rate[window])
+				label := quotaWindowLabel(value, []string{"Primary", "Secondary"}[i])
+				if key == "code_review_rate_limit" {
+					label = "Review " + label
+				}
+				addUsed(label, value, "used_percent", "reset_at")
+			}
+		}
+	case "claude":
+		for _, window := range []struct{ key, label string }{{"five_hour", "5h"}, {"seven_day", "7d"}, {"seven_day_oauth_apps", "7d Apps"}, {"seven_day_opus", "7d Opus"}, {"seven_day_sonnet", "7d Sonnet"}, {"seven_day_cowork", "7d Cowork"}, {"iguana_necktie", "7d Fable"}} {
+			addUsed(window.label, quotaObject(payload[window.key]), "utilization", "resets_at")
+			if len(limits) > 0 && limits[len(limits)-1].Label == window.label {
+				if window.key == "five_hour" {
+					limits[len(limits)-1].WindowSeconds = 5 * 3600
+				} else {
+					limits[len(limits)-1].WindowSeconds = 7 * 86400
+				}
+			}
+		}
+	case "meta":
+		usage := quotaObject(payload["subs_usage"])
+		for _, key := range []string{"window", "weekly"} {
+			addUsed(key, quotaObject(usage[key]), "used_percent", "resets_at")
+			if key == "weekly" && len(limits) > 0 && limits[len(limits)-1].Label == key && limits[len(limits)-1].WindowSeconds == 0 {
+				limits[len(limits)-1].WindowSeconds = 7 * 86400
+			}
+		}
+	case "go", "zen":
+		usage := quotaObject(payload["usage"])
+		addMeters := func(prefix string, meters map[string]any) {
+			for _, key := range []string{"rolling", "weekly", "monthly"} {
+				window := quotaObject(meters[key])
+				used := quotaFirstNumber(window, "usagePercent", "usedPercent", "percentUsed", "percent", "pct", "usage_percent", "used_percent", "utilization", "utilizationPercent", "utilization_percent")
+				if used == nil {
+					if spent, total := quotaFirstNumber(window, "used", "usage", "consumed", "usedMicroCents"), quotaFirstNumber(window, "limit", "total", "quota", "limitMicroCents"); spent != nil && total != nil && *total > 0 {
+						used = quotaNumber(*spent / *total * 100)
+					}
+				}
+				if used == nil {
+					continue
+				}
+				var reset int64
+				if offset := quotaFirstNumber(window, "resetInSec", "resetInSeconds", "resetSeconds", "reset_sec", "reset_in_sec", "resetsInSec", "resetsInSeconds", "resetIn", "resetSec", "reset_after_seconds"); offset != nil && *offset < 1e9 {
+					reset = now.Unix() + int64(*offset)
+				}
+				if reset == 0 {
+					reset = quotaFirstReset(window, "resetAt", "resetsAt", "reset_at", "resets_at", "nextReset", "next_reset", "renewAt", "renew_at")
+				}
+				duration := quotaWindowSeconds(window, reset)
+				if duration == 0 && key == "rolling" {
+					duration = 5 * 3600
+				}
+				if duration == 0 && key == "weekly" {
+					duration = 7 * 86400
+				}
+				limits = append(limits, quotaLimit{Label: prefix + key, RemainingPercent: quotaPercent(100 - *used), ResetAt: reset, WindowSeconds: duration})
+				if len(limits) >= maxQuotaLimits {
+					return
+				}
+			}
+		}
+		addMeters("", usage)
+		models := quotaObject(usage["models"])
+		keys := make([]string, 0, len(models))
+		for key := range models {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			if len(limits) >= maxQuotaLimits {
+				break
+			}
+			if label := quotaDisplayText(key); label != "" {
+				addMeters(label+" ", quotaObject(models[key]))
+			}
+		}
+	case "antigravity":
+		groups, _ := payload["groups"].([]any)
+		for i, rawGroup := range groups {
+			group := quotaObject(rawGroup)
+			groupName := quotaFirstText(group, "displayName", "display_name", "name")
+			buckets, _ := group["buckets"].([]any)
+			for j, rawBucket := range buckets {
+				if len(limits) >= maxQuotaLimits {
+					return limits
+				}
+				bucket := quotaObject(rawBucket)
+				if disabled, _ := bucket["disabled"].(bool); disabled {
+					continue
+				}
+				fraction := quotaNumber(bucket["remainingFraction"])
+				if fraction == nil {
+					fraction = quotaNumber(bucket["remaining_fraction"])
+				}
+				if fraction == nil {
+					remaining := quotaObject(bucket["remaining"])
+					fraction = quotaFirstNumber(remaining, "remainingFraction", "remaining_fraction")
+					if fraction == nil && remaining["case"] == "remainingFraction" {
+						fraction = quotaNumber(remaining["value"])
+					}
+				}
+				if fraction == nil {
+					continue
+				}
+				reset := quotaFirstReset(bucket, "resetTime", "reset_time", "end", "endsAt", "endAt", "period_end")
+				window := quotaObject(bucket["window"])
+				if reset == 0 {
+					reset = quotaFirstReset(window, "resetTime", "reset_time", "end", "endsAt", "endAt", "period_end")
+				}
+				duration := quotaWindowSeconds(bucket, reset)
+				if duration == 0 && window != nil {
+					duration = quotaWindowSeconds(window, reset)
+				}
+				if duration == 0 {
+					duration = quotaCadenceSeconds(bucket["bucketId"], bucket["bucket_id"], bucket["id"], bucket["displayName"], bucket["display_name"], bucket["name"], bucket["window"])
+				}
+				label := quotaBucketLabel(groupName, fmt.Sprintf("group %d window %d", i+1, j+1), quotaFirstText(bucket, "displayName", "display_name", "name", "window", "bucketId", "bucket_id", "id"))
+				limits = append(limits, quotaLimit{legacyLabel: fmt.Sprintf("group %d window %d", i+1, j+1), Label: label, RemainingPercent: quotaPercent(*fraction * 100), ResetAt: reset, WindowSeconds: duration})
+			}
+		}
+	case "xai":
+		config := quotaObject(payload["config"])
+		if config == nil {
+			config = payload
+		}
+		cents := func(value any) *float64 {
+			if object := quotaObject(value); object != nil {
+				value = object["val"]
+			}
+			return quotaNumber(value)
+		}
+		if used := quotaNumber(config["creditUsagePercent"]); used != nil {
+			period := quotaObject(config["currentPeriod"])
+			reset := quotaReset(period["end"])
+			limits = append(limits, quotaLimit{Label: "credits", RemainingPercent: quotaPercent(100 - *used), ResetAt: reset, WindowSeconds: quotaWindowSeconds(period, reset)})
+		}
+		if total, used := cents(config["monthlyLimit"]), cents(config["used"]); total != nil && used != nil && *total > 0 {
+			remaining := math.Max(0, *total-*used)
+			limits = append(limits, quotaLimit{Label: "monthly", RemainingPercent: quotaPercent(remaining / *total * 100), Remaining: &remaining, Total: total, Unit: "USD cents", ResetAt: quotaReset(config["billingPeriodEnd"])})
+		}
+	}
+	if len(limits) > maxQuotaLimits {
+		limits = limits[:maxQuotaLimits]
+	}
+	return limits
+}
diff --git a/internal/api/quota_pace.go b/internal/api/quota_pace.go
new file mode 100644
index 0000000..8b8731d
--- /dev/null
+++ b/internal/api/quota_pace.go
@@ -0,0 +1,350 @@
+package api
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type quotaPace struct {
+	State                    string   `json:"state"`
+	Label                    string   `json:"label"`
+	ExpectedRemainingPercent *float64 `json:"expected_remaining_percent,omitempty"`
+	MarginPercent            *float64 `json:"margin_percent,omitempty"`
+	RunsOutAt                int64    `json:"runs_out_at,omitempty"`
+}
+
+type quotaSummary struct {
+	quotaPace
+	RemainingPercent *float64 `json:"remaining_percent,omitempty"`
+	AccountID        string   `json:"account_id,omitempty"`
+	LimitLabel       string   `json:"limit_label,omitempty"`
+	MeasuredLimits   int      `json:"measured_limits"`
+	TotalLimits      int      `json:"total_limits"`
+	UnknownAccounts  int      `json:"unknown_accounts"`
+}
+
+func quotaLimitPace(limit quotaLimit, now time.Time, stale bool) *quotaPace {
+	pace := &quotaPace{State: "unknown", Label: "Pace unavailable"}
+	if stale || limit.RemainingPercent == nil || (limit.ResetAt > 0 && limit.ResetAt <= now.Unix()) {
+		return pace
+	}
+	remaining := *limit.RemainingPercent
+	if remaining == 0 {
+		pace.State, pace.Label = "exhausted", "Exhausted"
+	}
+	length := limit.WindowSeconds
+	left := float64(limit.ResetAt) - float64(now.Unix())
+	elapsed := length - left
+	if length <= 0 || limit.ResetAt == 0 || left <= 0 || elapsed < length/100 || elapsed > length {
+		return pace
+	}
+	expectedUsed := elapsed / length * 100
+	expectedRemaining := 100 - expectedUsed
+	margin := expectedUsed - (100 - remaining)
+	pace.ExpectedRemainingPercent, pace.MarginPercent = &expectedRemaining, &margin
+	if remaining == 0 {
+		pace.State, pace.Label = "exhausted", "Exhausted"
+	} else if margin >= .5 {
+		pace.State, pace.Label = "reserve", fmt.Sprintf("%.0f%% in reserve", margin)
+	} else if margin <= -.5 {
+		pace.State, pace.Label = "deficit", fmt.Sprintf("%.0f%% in deficit", -margin)
+	} else {
+		pace.State, pace.Label = "on_pace", "On pace"
+	}
+	used := 100 - remaining
+	if used > 0 {
+		seconds := remaining / (used / elapsed)
+		if seconds < left {
+			pace.RunsOutAt = now.Unix() + int64(seconds)
+		}
+	}
+	return pace
+}
+
+func summarizeQuota(accounts []quotaAccount) quotaSummary {
+	summary := quotaSummary{quotaPace: quotaPace{State: "unknown", Label: "Quota unavailable"}}
+	rank := map[string]int{"unknown": 0, "reserve": 1, "on_pace": 2, "deficit": 3, "exhausted": 4}
+	pending := false
+	for _, account := range accounts {
+		fresh := account.Status == "ok" && !account.Stale
+		known := fresh && len(account.Limits) > 0
+		if account.UpdatedAt == 0 && account.Stale {
+			pending = true
+		}
+		for _, limit := range account.Limits {
+			summary.TotalLimits++
+			pace := limit.Pace
+			if !fresh || pace == nil || pace.State == "unknown" {
+				known = false
+				continue
+			}
+			summary.MeasuredLimits++
+			worse := rank[pace.State] > rank[summary.State]
+			if rank[pace.State] == rank[summary.State] && pace.MarginPercent != nil && summary.MarginPercent != nil {
+				worse = *pace.MarginPercent < *summary.MarginPercent
+			}
+			if worse {
+				summary.quotaPace = *pace
+				summary.RemainingPercent, summary.AccountID, summary.LimitLabel = limit.RemainingPercent, account.ID, limit.Label
+				summary.Label = account.Label + " · " + limit.Label + " · " + pace.Label
+			}
+		}
+		if !known && account.Scope != "free" {
+			summary.UnknownAccounts++
+		}
+	}
+	if summary.State != "deficit" && summary.State != "exhausted" && (summary.UnknownAccounts > 0 || summary.MeasuredLimits < summary.TotalLimits) {
+		summary.quotaPace = quotaPace{State: "unknown", Label: "Incomplete quota coverage"}
+		summary.RemainingPercent, summary.AccountID, summary.LimitLabel = nil, "", ""
+	}
+	if pending && summary.MeasuredLimits == 0 && summary.State == "unknown" {
+		summary.Label = "Loading quota"
+	}
+	return summary
+}
+
+func quotaAPIKey(account *auth.Auth) string {
+	key := account.Attributes[auth.AttributeAPIKey]
+	if key == "" {
+		key, _ = account.Metadata[auth.AttributeAPIKey].(string)
+	}
+	return strings.TrimSpace(key)
+}
+
+func quotaInventoryAccount(account *auth.Auth) bool {
+	if quotaAPIKey(account) != "" {
+		return true
+	}
+	if account.AuthSourceKind() == auth.AuthSourceConfig || account.AuthKind() == auth.AuthKindAPIKey {
+		return false
+	}
+	return true
+}
+
+func quotaDisplayText(value string) string {
+	value = strings.TrimSpace(value)
+	if value == "" || len(value) > 160 {
+		return ""
+	}
+	for _, char := range value {
+		if unicode.IsControl(char) || char == '/' || char == '\\' {
+			return ""
+		}
+	}
+	return value
+}
+
+func quotaAccountLabel(account *auth.Auth, provider string) string {
+	console := provider == "go" || provider == "zen"
+	if provider != "other" && !console {
+		if label := quotaSafeAccountText(account, account.Label); label != "" && label != account.FileName && !strings.HasSuffix(label, ".json") && !strings.HasSuffix(label, "-apikey") && label != account.Provider {
+			return label
+		}
+	}
+	for _, key := range []string{"nickname", "email", "name"} {
+		if value, ok := account.Metadata[key].(string); ok {
+			if label := quotaSafeAccountText(account, value); label != "" {
+				return label
+			}
+		}
+		if console {
+			if label := quotaSafeAccountText(account, account.Attributes[key]); label != "" {
+				return label
+			}
+		}
+	}
+	if console {
+		return "OpenCode"
+	}
+	return provider
+}
+
+func quotaSafeAccountText(account *auth.Auth, value string) string {
+	label := quotaDisplayText(value)
+	if quotaContainsCredential(account, label) {
+		return ""
+	}
+	return label
+}
+
+func quotaContainsCredential(account *auth.Auth, label string) bool {
+	for _, key := range []string{"api_key", "access_token", "refresh_token", "id_token", "dca_token"} {
+		if token := strings.TrimSpace(account.Attributes[key]); token != "" && len(token) <= len(label) && strings.Contains(label, token) {
+			return true
+		}
+		if token, ok := account.Metadata[key].(string); ok {
+			token = strings.TrimSpace(token)
+			if token != "" && len(token) <= len(label) && strings.Contains(label, token) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func quotaLimitText(value string) string {
+	value = strings.TrimSpace(value)
+	if value == "Claude/GPT" {
+		return value
+	}
+	if strings.HasPrefix(value, "Claude/GPT ") && len(value) <= 160 && quotaDisplayText(strings.TrimPrefix(value, "Claude/GPT ")) != "" {
+		return value
+	}
+	return quotaDisplayText(value)
+}
+
+func quotaSafeLimitText(account *auth.Auth, value string) string {
+	label := quotaLimitText(value)
+	if quotaContainsCredential(account, label) {
+		return ""
+	}
+	return label
+}
+
+func quotaFirstText(object map[string]any, keys ...string) string {
+	for _, key := range keys {
+		if value, ok := object[key].(string); ok {
+			if label := quotaLimitText(value); label != "" {
+				return label
+			}
+		}
+	}
+	return ""
+}
+
+func quotaBucketLabel(group, fallback string, windows ...string) string {
+	window := ""
+	for _, value := range windows {
+		if name := quotaLimitText(value); name != "" {
+			window = name
+			break
+		}
+	}
+	if group == "" && window == "" {
+		return fallback
+	}
+	if window == "" {
+		window = "Quota"
+	}
+	if label := quotaLimitText(strings.TrimSpace(group + " " + window)); label != "" {
+		return label
+	}
+	return fallback
+}
+
+func quotaCadenceSeconds(values ...any) float64 {
+	for _, value := range values {
+		raw, ok := value.(string)
+		if !ok {
+			continue
+		}
+		normalized := strings.ReplaceAll(strings.ToLower(strings.TrimSpace(raw)), "_", "-")
+		candidates := []string{normalized, strings.TrimSuffix(normalized, " limit")}
+		for _, candidate := range candidates {
+			for _, alias := range []string{"session", "5h", "5-hour", "five hour", "five-hour"} {
+				if candidate == alias || strings.HasSuffix(candidate, "-"+alias) {
+					return 5 * 3600
+				}
+			}
+			if candidate == "weekly" || strings.HasSuffix(candidate, "-weekly") {
+				return 7 * 86400
+			}
+		}
+	}
+	return 0
+}
+
+func quotaFirstReset(window map[string]any, keys ...string) int64 {
+	for _, key := range keys {
+		if reset := quotaReset(window[key]); reset != 0 {
+			return reset
+		}
+	}
+	return 0
+}
+
+func quotaZenFreeOnly(account *auth.Auth, cfg *config.Config) bool {
+	if cfg == nil || account.AuthSourceKind() != auth.AuthSourceConfig {
+		return false
+	}
+	free := func(names []string) bool {
+		if len(names) == 0 {
+			return false
+		}
+		for _, name := range names {
+			if !strings.HasSuffix(name, "-free") && name != "big-pickle" {
+				return false
+			}
+		}
+		return true
+	}
+	key := quotaAPIKey(account)
+	matched := false
+	for _, entry := range cfg.CodexKey {
+		if entry.Prefix == "zen" && strings.TrimSpace(entry.APIKey) == key {
+			matched = true
+			names := make([]string, 0, len(entry.Models))
+			for _, model := range entry.Models {
+				names = append(names, model.Name)
+			}
+			if !free(names) {
+				return false
+			}
+		}
+	}
+	for _, entry := range cfg.OpenAICompatibility {
+		if entry.Prefix != "zen" {
+			continue
+		}
+		matches := false
+		for _, credential := range entry.APIKeyEntries {
+			if strings.TrimSpace(credential.APIKey) == key {
+				matches = true
+			}
+		}
+		if matches {
+			matched = true
+			names := make([]string, 0, len(entry.Models))
+			for _, model := range entry.Models {
+				names = append(names, model.Name)
+			}
+			if !free(names) {
+				return false
+			}
+		}
+	}
+	return matched
+}
+
+func quotaFirstNumber(window map[string]any, keys ...string) *float64 {
+	for _, key := range keys {
+		if number := quotaNumber(window[key]); number != nil {
+			return number
+		}
+	}
+	return nil
+}
+
+func quotaWindowSeconds(window map[string]any, reset int64) float64 {
+	seconds := quotaFirstNumber(window, "limit_window_seconds", "window_seconds", "windowSeconds")
+	if seconds == nil {
+		if minutes := quotaNumber(window["window_duration_mins"]); minutes != nil {
+			seconds = quotaNumber(*minutes * 60)
+		}
+	}
+	if seconds != nil && *seconds > 0 && *seconds <= 366*86400 {
+		return *seconds
+	}
+	for _, key := range []string{"start", "begin", "startsAt", "startAt", "started_at", "period_start"} {
+		if start := quotaReset(window[key]); start > 0 && reset > start && reset-start <= 366*86400 {
+			return math.Max(0, float64(reset-start))
+		}
+	}
+	return 0
+}
diff --git a/internal/api/quota_usage.go b/internal/api/quota_usage.go
new file mode 100644
index 0000000..38e5566
--- /dev/null
+++ b/internal/api/quota_usage.go
@@ -0,0 +1,87 @@
+package api
+
+import (
+	"context"
+	"time"
+
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+)
+
+// Token usage is kept in memory per quota account in hourly buckets, so the
+// rolling window restarts empty with the server.
+const quotaUsageBuckets = 7 * 24
+
+type quotaUsage struct {
+	Since            int64    `json:"since"`
+	WindowSeconds    int64    `json:"window_seconds"`
+	Requests         int64    `json:"requests"`
+	InputTokens      int64    `json:"input_tokens"`
+	CacheReadTokens  int64    `json:"cache_read_tokens"`
+	CacheWriteTokens int64    `json:"cache_write_tokens"`
+	OutputTokens     int64    `json:"output_tokens"`
+	CacheReadPercent *float64 `json:"cache_read_percent,omitempty"`
+}
+
+type quotaUsageBucket struct {
+	hour                                           int64
+	requests, input, cacheRead, cacheWrite, output int64
+}
+
+func (q *quotaEndpoint) HandleUsage(_ context.Context, record coreusage.Record) {
+	if q.manager == nil || len(q.key) == 0 {
+		return
+	}
+	account, ok := q.manager.GetByID(record.AuthID)
+	if !ok || account == nil {
+		return
+	}
+	at := record.RequestedAt
+	if at.IsZero() {
+		at = time.Now()
+	}
+	tokens := coreusage.EnsureTokenBreakdownForProvider(record.Detail, record.Provider, record.ExecutorType).TokenBreakdown
+	id := q.accountID(account)
+	hour := at.Unix() / 3600
+	q.usageMu.Lock()
+	defer q.usageMu.Unlock()
+	buckets := q.usage[id]
+	if buckets == nil {
+		buckets = make([]quotaUsageBucket, quotaUsageBuckets)
+		q.usage[id] = buckets
+	}
+	bucket := &buckets[hour%quotaUsageBuckets]
+	if bucket.hour != hour {
+		*bucket = quotaUsageBucket{hour: hour}
+	}
+	bucket.requests++
+	bucket.input += tokens.Input.UncachedTokens
+	bucket.cacheRead += tokens.Input.CacheReadTokens
+	bucket.cacheWrite += tokens.Input.CacheWriteTokens
+	bucket.output += tokens.Output.TotalTokens
+}
+
+func (q *quotaEndpoint) usageSnapshot(id string, now time.Time) *quotaUsage {
+	since := now.Add(-quotaUsageBuckets * time.Hour)
+	if q.started.After(since) {
+		since = q.started
+	}
+	result := &quotaUsage{Since: since.Unix(), WindowSeconds: int64(now.Sub(since).Seconds())}
+	oldest := now.Unix()/3600 - quotaUsageBuckets + 1
+	q.usageMu.Lock()
+	for _, bucket := range q.usage[id] {
+		if bucket.hour < oldest {
+			continue
+		}
+		result.Requests += bucket.requests
+		result.InputTokens += bucket.input
+		result.CacheReadTokens += bucket.cacheRead
+		result.CacheWriteTokens += bucket.cacheWrite
+		result.OutputTokens += bucket.output
+	}
+	q.usageMu.Unlock()
+	if total := result.InputTokens + result.CacheReadTokens + result.CacheWriteTokens; total > 0 {
+		percent := float64(result.CacheReadTokens) * 100 / float64(total)
+		result.CacheReadPercent = &percent
+	}
+	return result
+}
