+/// Serves the bodies the store already holds under another collection of the
+/// same message, narrowing the plans to the rest.
+///
+/// A message filed under several labels would otherwise be downloaded once
+/// per label, the store only folding the copies once they are written.
+fn reuse_held_bodies<'a>(
+    store: &PimdirSourceStore,
+    source: &str,
+    collections: impl Iterator<Item = &'a String>,
+    blobs: &PimdirBlobs,
+    plans: Vec<CollectionPlan>,
+) -> (Vec<CollectionPlan>, HashMap<FetchKey, PimdirFetchedItem>) {
+    let mut held: HashMap<String, PimdirPlacement> = HashMap::new();
+    for collection in collections {
+        let Ok(placements) = load_side(store, &hub_id(source, collection)) else {
+            continue;
+        };
+        for placement in placements {
+            if placement.object.is_some() && placement.status != PimdirStatus::Tombstone {
+                held.entry(placement.handle.0.clone()).or_insert(placement);
+            }
+        }
+    }
+
+    let mut cache = HashMap::new();
+    let plans = plans
+        .into_iter()
+        .map(|(collection, targets)| {
+            let targets = targets
+                .into_iter()
+                .filter(|(handle, _)| {
+                    let Some(placement) = held.get(&handle.0) else {
+                        return true;
+                    };
+                    let (Some(hash), Some(link_id)) =
+                        (placement.object.clone(), placement.link_id.clone())
+                    else {
+                        return true;
+                    };
+                    let Ok(meta) = fs::metadata(blobs.path(&hash)) else {
+                        return true;
+                    };
+                    let item = PimdirFetchedItem {
+                        handle: handle.clone(),
+                        link_id,
+                        summary: placement.summary.clone(),
+                        sort_key: placement.sort_key.clone(),
+                        body: Some(PimdirFetchedBody::Persisted {
+                            hash,
+                            size: meta.len() as usize,
+                        }),
+                        revision: None,
+                    };
+                    cache.insert((collection.clone(), handle.0.clone()), item);
+                    false
+                })
+                .collect();
+            (collection, targets)
+        })
+        .collect();
+
+    if !cache.is_empty() {
+        info!("reusing {} body(ies) {source} already holds", cache.len());
+    }
+    (plans, cache)
+}
+
