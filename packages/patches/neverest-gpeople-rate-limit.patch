+/// Whether People asked to slow down: a 429, or a 403 naming a per-minute
+/// rate limit. A daily quota stays a failure.
+fn is_rate_limited(err: &GpeopleClientStdError) -> bool {
+    let GpeopleClientStdError::Send(send) = err else {
+        return false;
+    };
+    match send {
+        GpeopleSendError::Api { status: 429, .. } => true,
+        GpeopleSendError::Api {
+            status: 403,
+            message,
+        } => {
+            let message = message.to_lowercase();
+            message.contains("rate limit") || message.contains("per minute")
+        }
+        _ => false,
+    }
+}
