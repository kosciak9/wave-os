+/// A calendar id as one URL path segment: io-gcal joins it into the path
+/// as is, and a holiday calendar's `#` would otherwise start the fragment.
+fn path_segment(id: &str) -> String {
+    id.replace('%', "%25")
+        .replace('#', "%23")
+        .replace('?', "%3F")
+        .replace('/', "%2F")
+}
