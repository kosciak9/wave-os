+const CLI_TIMEOUT_MS = 120_000;
+const CLI_MAX_OUTPUT = 16 * 1024 * 1024;
+let cliBusy = false;
+
+function runExclusive<T>(operation: () => Promise<T>): Promise<T> {
+  if (cliBusy) return Promise.reject(new Error('LanguageTool CLI is busy.'));
+  cliBusy = true;
+  return Promise.resolve().then(operation).finally(() => { cliBusy = false; });
+}
+
+function checkWithCli(text: string, language: string, picky: boolean, disabledRules: string[], enabledRules: string[]): Promise<LtCheckResponse> {
+  return runExclusive(() => new Promise((resolve, reject) => {
+    const args = ['-Xms64m', '-Xmx512m', '-XX:+UseSerialGC', '-Djava.io.tmpdir=/tmp', '-jar', process.env.LT_CLI_JAR!, '--json', '--language', language];
+    if (picky) args.push('--level', 'PICKY');
+    if (disabledRules.length) args.push('--disable', disabledRules.join(','));
+    if (enabledRules.length) args.push('--enable', enabledRules.join(','));
+    args.push('-');
+    let child;
+    try {
+      child = spawn(process.env.LT_JAVA_BIN || 'java', args, { stdio: ['pipe', 'pipe', 'pipe'] });
+    } catch {
+      // spawn() can throw before a ChildProcess exists, so there is no close event.
+      reject(new Error('LanguageTool CLI could not be started.'));
+      return;
+    }
+    let stdout: Buffer[] = []; let stdoutBytes = 0; let pendingError: Error | undefined;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const abort = (error: Error) => {
+      if (!pendingError) pendingError = error;
+      child.kill('SIGKILL');
+    };
+    const collect = (chunk: Buffer) => {
+      if (pendingError) return;
+      if (stdoutBytes + chunk.byteLength > CLI_MAX_OUTPUT) {
+        abort(new Error('LanguageTool CLI output exceeded the limit.'));
+        return;
+      }
+      stdout.push(chunk);
+      stdoutBytes += chunk.byteLength;
+    };
+    child.stdout.on('data', collect);
+    child.stderr.on('data', () => undefined);
+    child.on('error', () => abort(new Error('LanguageTool CLI could not be started.')));
+    child.stdin.on('error', () => abort(new Error('LanguageTool CLI input failed.')));
+    child.on('close', (code) => {
+      if (timer) clearTimeout(timer);
+      if (pendingError) { reject(pendingError); return; }
+      if (code !== 0) { reject(new Error('LanguageTool CLI check failed.')); return; }
+      try {
+        const output = Buffer.concat(stdout).toString('utf8');
+        resolve(JSON.parse(output) as LtCheckResponse);
+      } catch { reject(new Error('LanguageTool CLI returned invalid JSON.')); }
+    });
+    timer = setTimeout(() => abort(new Error('LanguageTool CLI check timed out.')), CLI_TIMEOUT_MS);
+    child.stdin.end(text);
+  }));
+}
