{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Developer/personal/wave-os/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/Developer/personal/wave-os.*/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/state/wave/*",
      "effect": "allow",
    },
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/nix/var/log/nix/*",
      "effect": "allow",
    },
  ],
}
