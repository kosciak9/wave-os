+std::vector<PHLWORKSPACE> CWorkspaceStateTracker::workspacesOnMonitor(PHLMONITOR monitor) const {
+    std::vector<PHLWORKSPACE> result;
+    for (const auto& workspace : m_workspaces) {
+        const auto ws = workspace.lock();
+        if (ws && !ws->m_isSpecialWorkspace && ws->m_monitor == monitor)
+            result.emplace_back(ws);
+    }
+    return result;
+}
+
+std::optional<size_t> CWorkspaceStateTracker::workspaceOrderIndex(PHLWORKSPACE workspace) const {
+    if (!workspace || workspace->m_isSpecialWorkspace)
+        return std::nullopt;
+    const auto monitor = workspace->m_monitor.lock();
+    if (!monitor)
+        return std::nullopt;
+    const auto ordered = workspacesOnMonitor(monitor);
+    const auto it = std::ranges::find(ordered, workspace);
+    if (it == ordered.end())
+        return std::nullopt;
+    return std::distance(ordered.begin(), it);
+}
+
+PHLWORKSPACE CWorkspaceStateTracker::workspaceInOrder(PHLWORKSPACE workspace, int64_t offset) const {
+    const auto index = workspaceOrderIndex(workspace);
+    if (!index)
+        return nullptr;
+    const auto ordered = workspacesOnMonitor(workspace->m_monitor.lock());
+    const auto target = sc<int64_t>(*index) + offset;
+    if (target < 0 || target >= sc<int64_t>(ordered.size()))
+        return nullptr;
+    return ordered[target];
+}
