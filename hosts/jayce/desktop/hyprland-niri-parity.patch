+        return std::nullopt;
+    const auto ORDERED = workspacesOnMonitor(MONITOR);
+    const auto IT      = std::ranges::find(ORDERED, workspace);
+    if (IT == ORDERED.end())
+        return std::nullopt;
+    return std::distance(ORDERED.begin(), IT);
+}
+
+PHLWORKSPACE CState::workspaceInOrder(PHLWORKSPACE workspace, int64_t offset) const {
+    const auto INDEX = workspaceOrderIndex(workspace);
+    if (!INDEX)
+        return nullptr;
+    const auto ORDERED = workspacesOnMonitor(workspace->m_monitor.lock());
+    const auto TARGET  = sc<int64_t>(*INDEX) + offset;
+    if (TARGET < 0 || TARGET >= sc<int64_t>(ORDERED.size()))
+        return nullptr;
+    return ORDERED[TARGET];
+}
